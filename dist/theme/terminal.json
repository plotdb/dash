{
  "name": "terminal",
  "title": {
    "zh-TW": "主控台",
    "en": "Terminal"
  },
  "desc": {
    "zh-TW": "整天開著它的人。等寬字、單色、1px 的框。這一版把「色相留給資料」那條規則拿掉了：所有維度共用同一個色相，分類靠明度順序與標籤。",
    "en": "For someone who keeps it open all day. Monospace, one hue, a 1px frame. This design drops the rule that hue belongs to the data: every dimension shares one hue, and categories are told apart by lightness order and labels."
  },
  "blocks": {
    "panel": {
      "name": "@plotdb/dash",
      "path": "block/panel/terminal/index.html"
    },
    "kpi": {
      "name": "@plotdb/dash",
      "path": "block/kpi/terminal/index.html"
    },
    "filterbar": {
      "name": "@plotdb/dash",
      "path": "block/filterbar/index.html"
    }
  },
  "_filterbar": "這一版的設計沒有自己的篩選列，沿用素版那一份；外觀是素版的，顏色由下面 vars 裡的 --dash-* 對應過去。",
  "layout": {
    "col": [
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr"
    ],
    "row": [
      "5.4em",
      "1.25fr",
      "1fr"
    ],
    "gap": "8px"
  },
  "tokens": {
    "common": {
      "mono": "ui-monospace, \"SF Mono\", Menlo, Consolas, \"Noto Sans Mono\", monospace",
      "gap": "8px",
      "radius": "0"
    },
    "light": {
      "bg": "#eceae3",
      "panel": "#f8f7f3",
      "fg": "#26282c",
      "fg-dim": "#767b83",
      "line": "#c9c6bd",
      "line-hi": "#9a968c",
      "hot": "#9a5e00",
      "on-accent": "#f8f7f3",
      "up": "#3f6b2b",
      "down": "#a8431f",
      "axis": "#767b83",
      "txt": "#4a4e55",
      "grid": "#d5d2c9",
      "baseline": "#d5d2c9",
      "face": "#f8f7f3",
      "outline": "#a5a198",
      "ref": "#9a5e00",
      "brush": {
        "fill": "#9a5e00",
        "fillOpacity": 0.1,
        "stroke": "rgba(154,94,0,.5)",
        "strokeWidth": 1,
        "handleFill": "rgba(154,94,0,.35)"
      },
      "cat": [
        "#5c3800",
        "#9a5e00",
        "#c08a3c",
        "#ddb77e"
      ],
      "cat-ramp": [
        "#efe6d4",
        "#9a5e00"
      ],
      "chn": [
        "#ddb77e",
        "#c08a3c",
        "#7a4a00"
      ],
      "geo": [
        "#9a5e00"
      ],
      "geo-ramp": [
        "#e4dac7",
        "#d2bb95",
        "#bf9c64",
        "#ac7d32",
        "#9a5e00"
      ],
      "empty": "#e4e2da"
    },
    "dark": {
      "bg": "#0b0b0c",
      "panel": "#111214",
      "fg": "#c8ccd2",
      "fg-dim": "#6f757e",
      "line": "#262a30",
      "line-hi": "#3a4049",
      "hot": "#ffb000",
      "on-accent": "#0b0b0c",
      "up": "#86c06a",
      "down": "#e0714c",
      "axis": "#6f757e",
      "txt": "#9aa0a8",
      "grid": "#22262b",
      "baseline": "#22262b",
      "face": "#111214",
      "outline": "#4d5258",
      "ref": "#ffb000",
      "brush": {
        "fill": "#ffb000",
        "fillOpacity": 0.1,
        "stroke": "rgba(255,176,0,.55)",
        "strokeWidth": 1,
        "handleFill": "rgba(255,176,0,.4)"
      },
      "cat": [
        "#ffd79a",
        "#ffb000",
        "#c77f00",
        "#7d5200"
      ],
      "cat-ramp": [
        "#3a2c12",
        "#ffb000"
      ],
      "chn": [
        "#ffd79a",
        "#c77f00",
        "#7d5200"
      ],
      "geo": [
        "#ffb000"
      ],
      "geo-ramp": [
        "#332917",
        "#664b11",
        "#996c0c",
        "#cc8e06",
        "#ffb000"
      ],
      "empty": "#1a1c1f"
    }
  },
  "vars": {
    "--tm-mono": "$mono",
    "--tm-bg": "$bg",
    "--tm-panel": "$panel",
    "--tm-fg": "$fg",
    "--tm-fg-dim": "$fg-dim",
    "--tm-line": "$line",
    "--tm-line-hi": "$line-hi",
    "--tm-hot": "$hot",
    "--tm-up": "$up",
    "--tm-down": "$down",
    "--dash-gap": "$gap",
    "--dash-radius": "$radius",
    "--dash-bg": "$bg",
    "--dash-panel-bg": "$panel",
    "--dash-border": "$line",
    "--dash-fg": "$fg",
    "--dash-fg-dim": "$fg-dim",
    "--dash-accent": "$hot",
    "--dash-on-accent": "$on-accent",
    "--dash-face": "$bg"
  },
  "root": {
    "background": "$bg",
    "color": "$fg",
    "font-family": "$mono"
  },
  "cfg": {
    "color": "$txt",
    "margin": 2,
    "xaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$axis",
        "font": {
          "size": ".76em"
        }
      },
      "tick": {
        "color": "$grid",
        "inner": 4
      },
      "baseline": {
        "color": "$baseline"
      }
    },
    "yaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$axis",
        "font": {
          "size": ".76em"
        }
      },
      "tick": {
        "color": "$grid",
        "inner": 0
      },
      "baseline": {
        "show": false
      },
      "grid": {
        "show": true,
        "color": "$grid",
        "opacity": 1
      }
    },
    "common": {
      "subset": {
        "background": "$face"
      },
      "brush": "$brush"
    }
  },
  "hue": {
    "cat": {
      "palette": {
        "colors": "$cat"
      }
    },
    "cat-ramp": {
      "palette": {
        "colors": "$cat-ramp"
      }
    },
    "chn": {
      "palette": {
        "colors": "$chn"
      }
    },
    "geo": {
      "palette": {
        "colors": "$geo"
      }
    },
    "geo-ramp": {
      "palette": {
        "colors": "$geo-ramp"
      }
    }
  },
  "chart": {
    "@makechart/taiwan-map": {
      "border": {
        "color": "$outline",
        "width": 1
      }
    },
    "@makechart/twmapadv": {
      "border": {
        "color": "$outline",
        "width": 0.6
      },
      "heat": {
        "sequential": {
          "colors": "$geo-ramp"
        },
        "empty": "$empty"
      },
      "label": {
        "color": "$axis",
        "halo": "$face"
      }
    }
  },
  "role": {
    "ref": {
      "common": {
        "annotation": {
          "color": "$ref"
        }
      }
    }
  },
  "schema": [
    {
      "key": "hot",
      "type": "color",
      "label": {
        "zh-TW": "強調色",
        "en": "Accent"
      },
      "desc": {
        "zh-TW": "整個介面只有這一個色相",
        "en": "The whole interface has exactly one hue"
      }
    },
    {
      "key": "bg",
      "type": "color",
      "label": {
        "zh-TW": "底色",
        "en": "Background"
      }
    },
    {
      "key": "panel",
      "type": "color",
      "label": {
        "zh-TW": "框內底色",
        "en": "Panel background"
      }
    },
    {
      "key": "line",
      "type": "color",
      "label": {
        "zh-TW": "框線",
        "en": "Frame"
      }
    },
    {
      "key": "fg",
      "type": "color",
      "label": {
        "zh-TW": "文字",
        "en": "Text"
      }
    },
    {
      "key": "fg-dim",
      "type": "color",
      "label": {
        "zh-TW": "次要文字",
        "en": "Secondary text"
      }
    },
    {
      "key": "up",
      "type": "color",
      "label": {
        "zh-TW": "上升",
        "en": "Up"
      }
    },
    {
      "key": "down",
      "type": "color",
      "label": {
        "zh-TW": "下降",
        "en": "Down"
      }
    },
    {
      "key": "mono",
      "type": "font",
      "label": {
        "zh-TW": "等寬字",
        "en": "Monospace"
      },
      "desc": {
        "zh-TW": "這一版的身分就在這個字型上",
        "en": "This design's identity rests on this font"
      }
    },
    {
      "key": "gap",
      "type": "length",
      "label": {
        "zh-TW": "格子間距",
        "en": "Cell gap"
      }
    },
    {
      "key": "cat",
      "type": "colors",
      "label": {
        "zh-TW": "類別色票",
        "en": "Category palette"
      },
      "desc": {
        "zh-TW": "並列的類別（書系）用這一組",
        "en": "For side-by-side categories"
      }
    },
    {
      "key": "cat-ramp",
      "type": "colors",
      "label": {
        "zh-TW": "類別漸層",
        "en": "Category ramp"
      },
      "desc": {
        "zh-TW": "依占比上色的圖用；同一個色族，但不假裝每一條都對得上",
        "en": "For charts coloured by share; same family, but it does not pretend each item lines up"
      }
    },
    {
      "key": "chn",
      "type": "colors",
      "label": {
        "zh-TW": "次維度色票",
        "en": "Secondary palette"
      },
      "desc": {
        "zh-TW": "另一個維度（通路），不跟類別搶色相",
        "en": "A second dimension; it does not compete with the category hues"
      }
    },
    {
      "key": "geo",
      "type": "colors",
      "label": {
        "zh-TW": "地區單色",
        "en": "Region, single colour"
      }
    },
    {
      "key": "geo-ramp",
      "type": "colors",
      "label": {
        "zh-TW": "地圖色階",
        "en": "Map ramp"
      },
      "desc": {
        "zh-TW": "由淺到深。低端貼著底色，底色換了它就得換",
        "en": "Light to dark. The low end sits against the background, so it has to change when the background does"
      }
    },
    {
      "key": "empty",
      "type": "color",
      "label": {
        "zh-TW": "沒有資料",
        "en": "No data"
      },
      "desc": {
        "zh-TW": "刻意跟資料色分開：沒有資料跟「數值最低」是兩件事",
        "en": "Deliberately separate from the data colours: no data and lowest value are two different things"
      }
    }
  ]
}
