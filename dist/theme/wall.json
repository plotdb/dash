{
  "name": "wall",
  "title": {
    "zh-TW": "牆面",
    "en": "Wall"
  },
  "desc": {
    "zh-TW": "十公尺外走過去的人。色塊拼貼、3px 的縫、巨大的數字；色票比其他版飽和一整級 —— 遠距離看，低彩度的差別會糊在一起。",
    "en": "For someone walking past ten metres away. Tiles, a 3px seam, huge numbers; the palette is a full step more saturated — at that distance low-chroma differences blur together."
  },
  "blocks": {
    "panel": {
      "name": "@plotdb/dash",
      "path": "block/panel/wall/index.html"
    },
    "kpi": {
      "name": "@plotdb/dash",
      "path": "block/kpi/wall/index.html"
    },
    "filterbar": {
      "name": "@plotdb/dash",
      "path": "block/filterbar/index.html"
    }
  },
  "_filterbar": "這一版的設計沒有自己的篩選列，沿用素版那一份；外觀是素版的，顏色由下面 vars 裡的 --dash-* 對應過去。",
  "layout": {
    "col": [
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr"
    ],
    "row": [
      ".85fr",
      "1.55fr",
      "1.25fr"
    ],
    "gap": "3px"
  },
  "tokens": {
    "common": {
      "sans": "\"Helvetica Neue\", -apple-system, \"PingFang TC\", \"Noto Sans TC\", system-ui, sans-serif",
      "gap": "3px",
      "radius": "0"
    },
    "light": {
      "bg": "#c7c2b8",
      "tile": "#faf8f4",
      "fg": "#15130f",
      "fg-dim": "#6e675e",
      "edge": "rgba(0,0,0,.22)",
      "hot": "#e0531f",
      "on-hot": "#fff8f2",
      "on-acc": "#fffaf4",
      "shade": "rgba(255,255,255,.22)",
      "shade-hi": "rgba(255,255,255,.62)",
      "acc-1": "#c07800",
      "acc-2": "#00796b",
      "acc-3": "#c43c22",
      "acc-4": "#2f5fc0",
      "axis": "#6e675e",
      "txt": "#36322c",
      "grid": "rgba(0,0,0,.12)",
      "baseline": "rgba(0,0,0,.12)",
      "face": "#faf8f4",
      "outline": "rgba(0,0,0,.35)",
      "ref": "#c07800",
      "brush": {
        "fill": "#000",
        "fillOpacity": 0.06,
        "stroke": "rgba(224,83,31,.6)",
        "strokeWidth": 1.5,
        "handleFill": "rgba(224,83,31,.4)"
      },
      "cat": [
        "#c07800",
        "#00796b",
        "#c43c22",
        "#2f5fc0"
      ],
      "cat-ramp": [
        "#f0e3c6",
        "#c07800"
      ],
      "chn": [
        "#e0a21f",
        "#c4521f",
        "#8f2113"
      ],
      "geo": [
        "#00796b"
      ],
      "geo-ramp": [
        "#d6ddd6",
        "#a0c4bb",
        "#6baba0",
        "#369286",
        "#00796b"
      ],
      "empty": "#e6e2da"
    },
    "dark": {
      "bg": "#0a0a09",
      "tile": "#1c1a19",
      "fg": "#f2efe9",
      "fg-dim": "#8d867d",
      "edge": "rgba(255,255,255,.2)",
      "hot": "#ffd166",
      "on-hot": "#0d0c0b",
      "on-acc": "#0d0c0b",
      "shade": "rgba(0,0,0,.16)",
      "shade-hi": "rgba(0,0,0,.52)",
      "acc-1": "#ffd166",
      "acc-2": "#26c6a6",
      "acc-3": "#ff8c61",
      "acc-4": "#8ab4ff",
      "axis": "#8d867d",
      "txt": "#cfc7bc",
      "grid": "rgba(255,255,255,.10)",
      "baseline": "rgba(255,255,255,.10)",
      "face": "#1c1a19",
      "outline": "rgba(255,255,255,.27)",
      "ref": "#ffd166",
      "brush": {
        "fill": "#fff",
        "fillOpacity": 0.08,
        "stroke": "rgba(255,209,102,.6)",
        "strokeWidth": 1.5,
        "handleFill": "rgba(255,209,102,.4)"
      },
      "cat": [
        "#ffd166",
        "#26c6a6",
        "#ff5d73",
        "#8ab4ff"
      ],
      "cat-ramp": [
        "#3f3a2c",
        "#ffd166"
      ],
      "chn": [
        "#ffd166",
        "#f3722c",
        "#9d2f1f"
      ],
      "geo": [
        "#26c6a6"
      ],
      "geo-ramp": [
        "#36403d",
        "#326257",
        "#2e8372",
        "#2aa48c",
        "#26c6a6"
      ],
      "empty": "#2a2826"
    }
  },
  "vars": {
    "--wl-sans": "$sans",
    "--wl-bg": "$bg",
    "--wl-tile": "$tile",
    "--wl-fg": "$fg",
    "--wl-fg-dim": "$fg-dim",
    "--wl-edge": "$edge",
    "--wl-hot": "$hot",
    "--wl-on-hot": "$on-hot",
    "--wl-on-acc": "$on-acc",
    "--wl-shade": "$shade",
    "--wl-shade-hi": "$shade-hi",
    "--wl-acc-1": "$acc-1",
    "--wl-acc-2": "$acc-2",
    "--wl-acc-3": "$acc-3",
    "--wl-acc-4": "$acc-4",
    "--dash-gap": "$gap",
    "--dash-radius": "$radius",
    "--dash-bg": "$bg",
    "--dash-panel-bg": "$tile",
    "--dash-border": "$edge",
    "--dash-fg": "$fg",
    "--dash-fg-dim": "$fg-dim",
    "--dash-accent": "$hot",
    "--dash-on-accent": "$on-hot",
    "--dash-face": "$shade"
  },
  "root": {
    "background": "$bg",
    "color": "$fg",
    "font-family": "$sans"
  },
  "cfg": {
    "color": "$txt",
    "margin": 2,
    "xaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$axis",
        "font": {
          "size": ".8em"
        }
      },
      "tick": {
        "color": "$grid",
        "inner": 4
      },
      "baseline": {
        "color": "$baseline"
      }
    },
    "yaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$axis",
        "font": {
          "size": ".8em"
        }
      },
      "tick": {
        "color": "$grid",
        "inner": 0
      },
      "baseline": {
        "show": false
      },
      "grid": {
        "show": true,
        "opacity": 0.09
      }
    },
    "common": {
      "subset": {
        "background": "$face"
      },
      "brush": "$brush"
    }
  },
  "hue": {
    "cat": {
      "palette": {
        "colors": "$cat"
      }
    },
    "cat-ramp": {
      "palette": {
        "colors": "$cat-ramp"
      }
    },
    "chn": {
      "palette": {
        "colors": "$chn"
      }
    },
    "geo": {
      "palette": {
        "colors": "$geo"
      }
    },
    "geo-ramp": {
      "palette": {
        "colors": "$geo-ramp"
      }
    }
  },
  "chart": {
    "@makechart/taiwan-map": {
      "border": {
        "color": "$outline",
        "width": 1
      }
    },
    "@makechart/twmapadv": {
      "border": {
        "color": "$outline",
        "width": 0.6
      },
      "heat": {
        "sequential": {
          "colors": "$geo-ramp"
        },
        "empty": "$empty"
      },
      "label": {
        "color": "$axis",
        "halo": "$face"
      }
    }
  },
  "role": {
    "ref": {
      "common": {
        "annotation": {
          "color": "$ref"
        }
      }
    }
  },
  "schema": [
    {
      "key": "hot",
      "type": "color",
      "label": {
        "zh-TW": "強調色",
        "en": "Accent"
      },
      "desc": {
        "zh-TW": "磚上的強調。它跟底色是一組的，底色一換就要跟著換",
        "en": "The accent on a tile. It comes as a pair with the background"
      }
    },
    {
      "key": "on-hot",
      "type": "color",
      "label": {
        "zh-TW": "強調色上的字",
        "en": "Text on accent"
      },
      "desc": {
        "zh-TW": "色塊上的字要跟著色塊換，不是跟著底色",
        "en": "Text on a colour block follows the block, not the page"
      }
    },
    {
      "key": "acc-1",
      "type": "color",
      "label": {
        "zh-TW": "磚色 1",
        "en": "Tile accent 1"
      },
      "desc": {
        "zh-TW": "KPI 磚的四個色",
        "en": "The four KPI tiles"
      }
    },
    {
      "key": "acc-2",
      "type": "color",
      "label": {
        "zh-TW": "磚色 2",
        "en": "Tile accent 2"
      }
    },
    {
      "key": "acc-3",
      "type": "color",
      "label": {
        "zh-TW": "磚色 3",
        "en": "Tile accent 3"
      }
    },
    {
      "key": "acc-4",
      "type": "color",
      "label": {
        "zh-TW": "磚色 4",
        "en": "Tile accent 4"
      }
    },
    {
      "key": "bg",
      "type": "color",
      "label": {
        "zh-TW": "縫的顏色",
        "en": "Seam colour"
      },
      "desc": {
        "zh-TW": "磚與磚之間那 3px。這一版沒有邊框，縫就是分隔",
        "en": "The 3px between tiles. There are no borders here — the seam is the separator"
      }
    },
    {
      "key": "tile",
      "type": "color",
      "label": {
        "zh-TW": "磚底色",
        "en": "Tile background"
      }
    },
    {
      "key": "fg",
      "type": "color",
      "label": {
        "zh-TW": "文字",
        "en": "Text"
      }
    },
    {
      "key": "gap",
      "type": "length",
      "label": {
        "zh-TW": "縫寬",
        "en": "Seam width"
      }
    },
    {
      "key": "cat",
      "type": "colors",
      "label": {
        "zh-TW": "類別色票",
        "en": "Category palette"
      },
      "desc": {
        "zh-TW": "並列的類別（書系）用這一組",
        "en": "For side-by-side categories"
      }
    },
    {
      "key": "cat-ramp",
      "type": "colors",
      "label": {
        "zh-TW": "類別漸層",
        "en": "Category ramp"
      },
      "desc": {
        "zh-TW": "依占比上色的圖用；同一個色族，但不假裝每一條都對得上",
        "en": "For charts coloured by share; same family, but it does not pretend each item lines up"
      }
    },
    {
      "key": "chn",
      "type": "colors",
      "label": {
        "zh-TW": "次維度色票",
        "en": "Secondary palette"
      },
      "desc": {
        "zh-TW": "另一個維度（通路），不跟類別搶色相",
        "en": "A second dimension; it does not compete with the category hues"
      }
    },
    {
      "key": "geo",
      "type": "colors",
      "label": {
        "zh-TW": "地區單色",
        "en": "Region, single colour"
      }
    },
    {
      "key": "geo-ramp",
      "type": "colors",
      "label": {
        "zh-TW": "地圖色階",
        "en": "Map ramp"
      },
      "desc": {
        "zh-TW": "由淺到深。低端貼著底色，底色換了它就得換",
        "en": "Light to dark. The low end sits against the background, so it has to change when the background does"
      }
    },
    {
      "key": "empty",
      "type": "color",
      "label": {
        "zh-TW": "沒有資料",
        "en": "No data"
      },
      "desc": {
        "zh-TW": "刻意跟資料色分開：沒有資料跟「數值最低」是兩件事",
        "en": "Deliberately separate from the data colours: no data and lowest value are two different things"
      }
    }
  ]
}
