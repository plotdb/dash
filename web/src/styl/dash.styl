// @plotdb/dash 基本 CSS
//
// 只做兩件事: 版面 ( .dash / .dash-cell ) 與卡片外觀 ( .dash-panel ).
// 顏色與間距走 custom property, 讓套用的專案能只改變數就換皮.

:root
  --dash-bg: #f7f8f9
  --dash-panel-bg: #fff
  --dash-border: #e7e8e9
  --dash-fg: #333435
  --dash-fg-dim: #8b8d8f
  --dash-accent: #0b7fab
  --dash-radius: .3em
  --dash-gap: .8em

.dash, .dash-cell, .dash-panel, .dash-page, .dash-toolbar
  box-sizing: border-box

// 版面: 由 board.layout! 依 def 寫入 grid-template
.dash
  display: grid
  width: 100%
  height: 100%
  min-width: 0
  min-height: 0
  overflow: hidden
  gap: var(--dash-gap)

// 有彈出層的儀表板 ( 下拉篩選、選單 ): 彈出層一定會超出自己那一格, 上面那條
// overflow: hidden 會把它裁掉一半.
//
// 不改預設值是因為那條 hidden 是真的有用的 - .dash-panel 自己不裁切, 所以圖表
// 畫出格子外時, 擋住的就是它. 需要的人打開就好, 而且「需要」是整張板子的性質,
// 不是某一格的 - 所以 class 掛在 .dash 上.
//
// 需要它的 block 自己加就行 ( filterbar 的 init 就是這樣做的 ), 宿主不必記得.
.dash.dash-overflow
  overflow: visible

// split 版面: 一棵巢狀 flex. 葉子是 .dash-cell, 其餘是 .dash-split.
// 間距不用 CSS gap, 而是讓分隔線自己佔掉那個寬度 - 這樣有沒有開拖拉, 間距一樣寬,
// 而且分隔線本來就該在兩格中間, 不是疊在間距上面
.dash.dash-split
  display: flex
  // 間距由分隔線自己佔掉, 所以要把 .dash 的 gap 關掉 - 不關的話根容器會是
  // 「gap + 分隔線 + gap」, 三倍寬. 巢狀的 .dash-split 沒有這個問題 ( 它不是
  // .dash, 吃不到那一條 ), 所以只有最外面那一層會跟版面裡面對不齊
  gap: 0
.dash-split
  display: flex
  min-width: 0
  min-height: 0

// 分隔線. 不能拖的時候它就只是間距
.dash-handle
  flex: 0 0 auto
  position: relative
.dash-handle-on
  // 間距通常只有 .8em 上下, 直接拿它當熱區會很難點中, 所以往兩邊各長 3px.
  // 長出來的部分疊在隔壁格子上, 但 pointer-events 只在這一條上
  &:before
    content: ''
    position: absolute
    top: -3px
    right: -3px
    bottom: -3px
    left: -3px
    border-radius: 2px
  &:hover:before
    background: var(--dash-accent)
    opacity: .3
[data-dir=row] > .dash-handle-on
  cursor: col-resize
[data-dir=col] > .dash-handle-on
  cursor: row-resize
// 拖的時候整頁都別選到文字, 游標也別因為滑過別的元素就變回來
body.dash-dragging
  user-select: none
  *
    cursor: inherit !important

// 按住 shift 拖分隔線時的吸附參考線. 畫在 body 上 ( 不是格子裡 ):
// 它要跨過整個版面, 而格子是 overflow: hidden 的
.dash-snapline
  position: fixed
  z-index: 9999
  pointer-events: none
  background: var(--dash-accent)
  opacity: .75

// 還沒放圖表的格子. 看得見才有辦法在上面放東西
.dash-cell.dash-empty
  border: 1px dashed var(--dash-border)
  border-radius: var(--dash-radius)

// grid item 預設 min-height 是 auto, 內容 ( svg ) 會把格子撐開而不是被格子限制,
// 所以一定要壓成 0, 否則圖表放大後版面會被推爆.
.dash-cell
  min-width: 0
  min-height: 0
  display: flex

.dash-panel
  flex: 1 1 auto
  min-width: 0
  min-height: 0
  display: flex
  flex-direction: column
  gap: .3em
  padding: .4em .6em
  color: var(--dash-fg)
  background: var(--dash-panel-bg)
  border: 1px solid var(--dash-border)
  border-radius: var(--dash-radius)
  box-shadow: 0 1px 3px rgba(0,0,0,.08)

  // 固定高度而不是讓內容決定: 副標題與「篩選中」的行高跟標題不一樣,
  // 不固定的話有沒有它們就差一兩個 px, 同一列卡片的圖表上緣會錯開
  > .dash-head
    flex: 0 0 auto
    display: flex
    align-items: center
    gap: .4em
    height: 1.5em
    font-size: .9em

  > .dash-body
    flex: 1 1 auto
    min-height: 0
    position: relative

// 收縮順序: 先截副標題, 截到沒了才輪到標題 ( shrink 權重差 100 倍 ).
// 右側的狀態與提示不讓 ( flex: 0 0 auto )
.dash-title
  flex: 0 1 auto
  min-width: 0
  font-weight: bold
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

// 副標題跟在標題後面, 空間不夠時先截斷它 ( 標題與右側的狀態不讓 ).
// 整列是單行而且高度固定, 所以有沒有副標題、有沒有「篩選中」,
// 每張卡片的圖表上緣都對齊
.dash-sub
  flex: 0 100 auto
  min-width: 0
  color: var(--dash-fg-dim)
  font-size: .85em
  white-space: nowrap
  overflow: hidden
  text-overflow: ellipsis

.dash-spacer
  flex: 1 1 auto

// 操作提示. 內容由 panel block 依圖表的設定推出來 ( 見 block 的 index.ls ),
// 不是宿主在副標題手寫的 - 換一種圖或改一個設定, 提示就跟著改.
// 篩選中時它讓位給「篩選中 ✕」: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
.dash-hint
  position: relative
  flex: 0 0 auto
  width: 1.25em
  height: 1.25em
  border-radius: 50%
  border: 1px solid var(--dash-border)
  color: var(--dash-fg-dim)
  font-size: .8em
  line-height: 1.15em
  text-align: center
  cursor: help

  &:before
    content: '?'

  &:hover > .dash-hint-pop
    display: block

// 彈出來的那一塊刻意往卡片內部開: 格子是 overflow: hidden 的, 往外開會被裁掉
.dash-hint-pop
  display: none
  position: absolute
  top: 140%
  right: 0
  z-index: 20
  padding: .45em .65em
  font-size: 1em
  line-height: 1.8
  font-weight: normal
  text-align: left
  white-space: nowrap
  color: var(--dash-fg)
  background: var(--dash-panel-bg)
  border: 1px solid var(--dash-border)
  border-radius: var(--dash-radius)
  box-shadow: 0 .4em 1.4em rgba(0,0,0,.18)

.dash-panel.filtering > .dash-head .dash-hint
  display: none

// 這張圖正在對外發 filter 時的狀態
.dash-tag
  display: none
  align-items: center
  gap: .3em
  padding: 0 .4em
  font-size: .8em
  line-height: 1.6em
  color: #fff
  border-radius: 1em
  background: var(--dash-accent)
  cursor: pointer

.dash-panel.filtering
  border-color: var(--dash-accent)

  > .dash-head .dash-tag
    display: inline-flex

// 頁面外框: 讓 demo 頁不必自己再寫一次
.dash-page
  width: 100%
  height: 100%
  display: flex
  flex-direction: column
  gap: var(--dash-gap)
  padding: var(--dash-gap)
  background: var(--dash-bg)
  color: var(--dash-fg)

.dash-toolbar
  flex: 0 0 auto
  display: flex
  align-items: center
  gap: .5em
  padding: .5em .8em
  background: var(--dash-panel-bg)
  border: 1px solid var(--dash-border)
  border-radius: var(--dash-radius)

// 使用者在系統裡說了「減少動態」就不要動態. 這一條放在這裡而不是各頁面裡,
// 是因為它跟版面一樣是每個用到這套 CSS 的頁面都該有的.
// ( 副作用: headless 截圖也會直接拿到最終畫面, 不會截到跑到一半的補間 )
@media (prefers-reduced-motion: reduce)
  *, *:before, *:after
    animation-duration: .001ms !important
    animation-iteration-count: 1 !important
    transition-duration: .001ms !important
