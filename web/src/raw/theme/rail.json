{
  "name": "rail",
  "title": {"zh-TW": "側欄", "en": "Rail"},
  "desc": {
    "zh-TW": "報紙的色票：大部分是黑白，顏色只用在需要分辨的地方。單色的長條圖就用最黑的那個黑，紅色留給「現在被選中的是哪一塊」。標題下面一條粗線，卡片只有一層細框。",
    "en": "A newspaper palette: mostly black and white, with colour reserved for what has to be told apart. A single-series bar chart gets the blackest black; red is kept for what is selected right now. A heavy rule under the heading, a single hairline around the card."
  },
  "fit": {
    "zh-TW": "配把 KPI 立成一整欄的版面：KPI 各佔 `col: [1, 3]` 的一列，主圖吃掉右邊其餘的欄。立起來之後每個數字有一整欄的寬度，字級可以放到 42px，四個數字變成一條一眼掃得完的清單。代價是四個數字直的疊起來要吃掉四列，右邊的圖只能跟著切。",
    "en": "Pairs with a layout that stands the KPIs up in one column: each takes a row of `col: [1, 3]`, and the main chart takes the remaining columns. Standing up gives each number a full column, so type can go to 42px and the four read as one scannable list. The cost is that four stacked numbers eat four rows, and the charts on the right have to divide the same rows."
  },
  "blocks": {
    "panel": {"name": "@plotdb/dash", "path": "block/panel/rail/index.html"},
    "kpi": {"name": "@plotdb/dash", "path": "block/kpi/rail/index.html"},
    "filterbar": {"name": "@plotdb/dash", "path": "block/filterbar/index.html"}
  },
  "layout": {
    "col": ["1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr", "1fr"],
    "row": ["8.2em", "8.2em", "9em", "9em", "19em"],
    "gap": "18px"
  },
  "tokens": {
    "common": {
      "sans": "\"Helvetica Neue\", Inter, -apple-system, \"PingFang TC\", \"Noto Sans TC\", system-ui, sans-serif",
      "gap": "18px",
      "radius": "0"
    },
    "light": {
      "bg": "#ffffff",
      "fg": "#2b2f36",
      "fg-strong": "#0a0c0f",
      "fg-dim": "#767d88",
      "line": "rgba(10,12,15,.16)",
      "soft": "rgba(10,12,15,.09)",
      "accent": "#d7263d",
      "on-accent": "#ffffff",
      "up": "#1a7f5a",
      "down": "#d7263d",
      "acc-1": "#d7263d",
      "acc-2": "#0a0c0f",
      "acc-3": "#767d88",
      "acc-4": "#1f4ea8",
      "ink": "#767d88",
      "txt": "#3a3f47",
      "grid": "rgba(10,12,15,.13)",
      "face": "#ffffff",
      "outline": "rgba(10,12,15,.36)",
      "ref": "#d7263d",
      "empty": "#edeef0",
      "brush": {
        "fill": "#d7263d",
        "fillOpacity": 0.08,
        "stroke": "rgba(215,38,61,.5)",
        "strokeWidth": 1,
        "handleFill": "rgba(215,38,61,.35)"
      },
      "cat": ["#d7263d", "#1f4ea8", "#0a0c0f", "#9aa1ab"],
      "cat-ramp": ["#f4ccd2", "#d7263d"],
      "chn": ["#1f4ea8", "#6f8fcd", "#b9c6e0"],
      "geo": ["#0a0c0f"],
      "geo-ramp": ["#e2e3e6", "#acadb0", "#76787a", "#404245", "#0a0c0f"]
    },
    "dark": {
      "bg": "#0c0d10",
      "fg": "#d4d8de",
      "fg-strong": "#f7f8fa",
      "fg-dim": "#858c97",
      "line": "rgba(247,248,250,.20)",
      "soft": "rgba(247,248,250,.12)",
      "accent": "#ff4d60",
      "on-accent": "#0c0d10",
      "up": "#3ec28f",
      "down": "#ff4d60",
      "acc-1": "#ff4d60",
      "acc-2": "#f7f8fa",
      "acc-3": "#858c97",
      "acc-4": "#6f9bff",
      "ink": "#858c97",
      "txt": "#c2c8d0",
      "grid": "rgba(247,248,250,.16)",
      "face": "#0c0d10",
      "outline": "rgba(247,248,250,.28)",
      "ref": "#ff4d60",
      "empty": "#1a1c20",
      "brush": {
        "fill": "#ff4d60",
        "fillOpacity": 0.1,
        "stroke": "rgba(255,77,96,.55)",
        "strokeWidth": 1,
        "handleFill": "rgba(255,77,96,.4)"
      },
      "cat": ["#ff4d60", "#6f9bff", "#f7f8fa", "#858c97"],
      "cat-ramp": ["#3a2126", "#ff4d60"],
      "chn": ["#6f9bff", "#3f6bbf", "#27385c"],
      "geo": ["#f7f8fa"],
      "geo-ramp": ["#25272d", "#5a5b60", "#8e9094", "#c2c4c7", "#f7f8fa"]
    }
  },
  "vars": {
    "--rl-sans": "$sans",
    "--rl-bg": "$bg",
    "--rl-fg": "$fg",
    "--rl-fg-strong": "$fg-strong",
    "--rl-fg-dim": "$fg-dim",
    "--rl-line": "$line",
    "--rl-soft": "$soft",
    "--rl-accent": "$accent",
    "--rl-on-accent": "$on-accent",
    "--rl-up": "$up",
    "--rl-down": "$down",
    "--rl-acc-1": "$acc-1",
    "--rl-acc-2": "$acc-2",
    "--rl-acc-3": "$acc-3",
    "--rl-acc-4": "$acc-4",
    "--dash-gap": "$gap",
    "--dash-radius": "$radius",
    "--dash-bg": "$bg",
    "--dash-panel-bg": "$bg",
    "--dash-border": "$line",
    "--dash-fg": "$fg",
    "--dash-fg-dim": "$fg-dim",
    "--dash-accent": "$accent",
    "--dash-on-accent": "$on-accent",
    "--dash-face": "$soft"
  },
  "root": {"background": "$bg", "color": "$fg", "font-family": "$sans"},
  "cfg": {
    "color": "$txt",
    "margin": 2,
    "xaxis": {
      "caption": {"show": false},
      "label": {"format": ".2~s", "color": "$ink", "font": {"size": ".78em"}},
      "tick": {"color": "$grid", "inner": 4},
      "baseline": {"color": "$grid"}
    },
    "yaxis": {
      "caption": {"show": false},
      "label": {"format": ".2~s", "color": "$ink", "font": {"size": ".78em"}},
      "tick": {"color": "$grid", "inner": 0},
      "baseline": {"show": false},
      "grid": {"show": true, "color": "$grid"}
    },
    "common": {
      "subset": {"background": "$face"},
      "brush": "$brush"
    }
  },
  "hue": {
    "cat": {"palette": {"colors": "$cat"}},
    "cat-ramp": {"palette": {"colors": "$cat-ramp"}},
    "chn": {"palette": {"colors": "$chn"}},
    "geo": {"palette": {"colors": "$geo"}},
    "geo-ramp": {"palette": {"colors": "$geo-ramp"}}
  },
  "chart": {
    "@makechart/taiwan-map": {"border": {"color": "$outline", "width": 1}},
    "@makechart/twmapadv": {
      "border": {"color": "$outline", "width": 0.6},
      "heat": {"sequential": {"colors": "$geo-ramp"}, "empty": "$empty"},
      "label": {"color": "$ink", "halo": "$bg"}
    }
  },
  "role": {"ref": {"common": {"annotation": {"color": "$ref"}}}},
  "schema": [
    {"key": "accent", "type": "color",
     "label": {"zh-TW": "主色", "en": "Accent"},
     "desc": {"zh-TW": "「現在被選中的是哪一塊」。報紙只有兩塊彩色可用，這是其中一塊", "en": "What is selected right now. A newspaper has only two patches of colour to spend; this is one of them"}},
    {"key": "bg", "type": "color",
     "label": {"zh-TW": "紙", "en": "Paper"},
     "desc": {"zh-TW": "整頁的底。卡片不另外上底色，所以它也是卡片的底", "en": "The page. Cards have no fill of their own, so it is their background too"}},
    {"key": "fg-strong", "type": "color",
     "label": {"zh-TW": "墨", "en": "Ink"},
     "desc": {"zh-TW": "標題下面那條粗線、單色長條圖用的黑", "en": "The heavy rule under the heading, and the black a single-series bar chart uses"}},
    {"key": "fg", "type": "color",
     "label": {"zh-TW": "文字", "en": "Text"},
     "desc": {"zh-TW": "一般文字", "en": "Body text"}},
    {"key": "fg-dim", "type": "color",
     "label": {"zh-TW": "次要文字", "en": "Muted text"},
     "desc": {"zh-TW": "副標題、軸線文字", "en": "Subtitles and axis labels"}},
    {"key": "line", "type": "color",
     "label": {"zh-TW": "框線", "en": "Rule"},
     "desc": {"zh-TW": "卡片只有這一層細框", "en": "The single hairline around a card"}},
    {"key": "gap", "type": "length",
     "label": {"zh-TW": "格間距", "en": "Gap"},
     "desc": {"zh-TW": "欄與欄之間的白。報紙靠留白分欄，不靠線", "en": "The white between columns; a newspaper separates with space, not lines"}},
    {"key": "sans", "type": "font",
     "label": {"zh-TW": "字體", "en": "Font"},
     "desc": {"zh-TW": "整個版面只有一種字體", "en": "The whole design uses a single family"}},
    {"key": "cat", "type": "colors",
     "label": {"zh-TW": "分類色", "en": "Categorical"},
     "desc": {"zh-TW": "紅、藍、黑、灰。不是四個色相平均分配 —— 報紙只有兩塊彩色可用，剩下的靠明度", "en": "Red, blue, black, grey. Not four hues spread evenly: only two are colour, the rest is lightness"}},
    {"key": "geo-ramp", "type": "colors",
     "label": {"zh-TW": "地圖漸層", "en": "Map ramp"},
     "desc": {"zh-TW": "地圖的連續色階，走的是灰到黑", "en": "The sequential scale on maps, grey through black"}},
    {"key": "acc-1", "type": "color",
     "label": {"zh-TW": "強調色 1", "en": "Accent 1"},
     "desc": {"zh-TW": "左欄四個數字各自的色", "en": "The colour of each of the four numbers in the left column"}},
    {"key": "acc-2", "type": "color", "label": {"zh-TW": "強調色 2", "en": "Accent 2"}, "desc": {"zh-TW": "同上", "en": "As above"}},
    {"key": "acc-3", "type": "color", "label": {"zh-TW": "強調色 3", "en": "Accent 3"}, "desc": {"zh-TW": "同上", "en": "As above"}},
    {"key": "acc-4", "type": "color", "label": {"zh-TW": "強調色 4", "en": "Accent 4"}, "desc": {"zh-TW": "同上", "en": "As above"}}
  ]
}
