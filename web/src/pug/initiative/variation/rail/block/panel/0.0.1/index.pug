div(ld-scope)
  .rl-panel(ld="panel")
    .rl-head
      .rl-rule
      .rl-titles
        .rl-title(ld="title")
        .rl-sub(ld="sub")
      .rl-spacer
      .rl-tag(ld="tag") 篩選中 ✕
    .rl-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 沒有卡片, 也沒有框. 每一格的上緣是一條粗線 -
    // 粗線是標題的一部分, 不是分隔線: 它跟標題一起構成「這是一節的開頭」
    .rl-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      color: var(--rl-fg)

    .rl-head
      flex: 0 0 auto
      display: flex
      align-items: baseline
      gap: 10px
      flex-wrap: wrap
      padding-bottom: 8px

    .rl-rule
      flex: 0 0 100%
      height: 3px
      margin-bottom: 9px
      background: var(--rl-fg-strong)
      transition: background-color .2s

    .rl-titles
      min-width: 0
    .rl-title
      font-size: 17px
      font-weight: 700
      letter-spacing: -.01em
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis
    .rl-sub
      margin-top: 2px
      font-size: 11.5px
      line-height: 1.5
      color: var(--rl-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .rl-spacer
      flex: 1 1 auto

    .rl-tag
      display: none
      flex: 0 0 auto
      padding: 2px 9px
      font-size: 11px
      font-weight: 600
      color: var(--rl-on-accent)
      background: var(--rl-accent)
      cursor: pointer

    .rl-body
      flex: 1 1 auto
      min-height: 0
      position: relative

    // 篩選中 = 那條粗線換成強調色. 這一版沒有邊框可以亮, 只有這條線
    .rl-panel.filtering
      > .rl-head
        .rl-rule
          background: var(--rl-accent)
        .rl-tag
          display: block
  script: include:lsc index.ls
