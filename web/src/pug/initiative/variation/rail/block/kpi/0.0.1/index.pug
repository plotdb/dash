div
  .rl-kpi
    .rl-kpi-label(ld="label")
    .rl-kpi-value
      span.rl-kpi-num(ld="num") 0
      span.rl-kpi-unit(ld="unit")
    .rl-kpi-note(ld="note")
    .rl-kpi-rail
      .rl-kpi-fill(ld="fill")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 側欄的一格. 四格疊成一條, 所以分隔只要一條細線, 不必每格都是卡片
    .rl-kpi
      --rl-kpi-accent: var(--rl-accent)
      position: relative
      flex: 1 1 auto
      min-width: 0
      display: flex
      flex-direction: column
      justify-content: center
      gap: 2px
      padding: 8px 0 10px
      border-top: 1px solid var(--rl-line)

    .rl-kpi-label
      font-size: 11px
      font-weight: 600
      letter-spacing: .14em
      text-transform: uppercase
      color: var(--rl-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .rl-kpi-value
      display: flex
      align-items: baseline
      gap: 7px
      min-width: 0

    // 側欄有一整欄的寬度, 所以數字可以放到很大 - 這是這一版的主角
    .rl-kpi-num
      // 四格疊在一欄裡, 所以字級跟著格高走: 1100px 高的螢幕放得下 42px,
      // 筆電的 800px 放不下, 兩邊都得成立
      font-size: clamp(26px, 2.6vw, 42px)
      font-weight: 750
      line-height: 1.05
      letter-spacing: -.03em
      font-variant-numeric: tabular-nums
      color: var(--rl-fg-strong)
    .rl-kpi-unit
      font-size: 12px
      color: var(--rl-fg-dim)

    .rl-kpi-note
      margin-top: 3px
      font-size: 11.5px
      font-variant-numeric: tabular-nums
      color: var(--rl-fg-dim)
      white-space: nowrap
      &.up
        color: var(--rl-up)
      &.down
        color: var(--rl-down)

    .rl-kpi-rail
      margin-top: 8px
      height: 4px
      background: var(--rl-soft)
      overflow: hidden
    .rl-kpi-fill
      width: 100%
      height: 100%
      background: var(--rl-kpi-accent)
      transition: width .45s cubic-bezier(.22,.8,.3,1)
  script: include:lsc index.ls
