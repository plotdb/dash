div(ld-scope)
  .tm-kpi
    .tm-kpi-label(ld="label")
    .tm-kpi-value
      span.tm-kpi-num(ld="num") 0
      span.tm-kpi-unit(ld="unit")
    .tm-kpi-bar
      span.tm-kpi-fill(ld="fill")
      span.tm-kpi-note(ld="note")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    .tm-kpi
      position: relative
      flex: 1 1 auto
      min-width: 0
      display: flex
      flex-direction: column
      justify-content: center
      gap: 4px
      padding: 7px 10px 8px
      font-family: var(--tm-mono)
      color: var(--tm-fg)
      background: var(--tm-panel)
      border: 1px solid var(--tm-line)
      transition: background-color .25s

    .tm-kpi-label
      font-size: 10.5px
      font-weight: 700
      letter-spacing: .12em
      text-transform: uppercase
      color: var(--tm-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .tm-kpi-value
      display: flex
      align-items: baseline
      gap: 6px
      min-width: 0

    .tm-kpi-num
      font-size: 26px
      font-weight: 700
      line-height: 1.1
      letter-spacing: -.01em
      // 等寬字本來就是等寬數字, 這一行是為了那幾個用比例數字的 fallback 字型
      font-variant-numeric: tabular-nums
      color: var(--tm-hot)

    .tm-kpi-unit
      font-size: 10.5px
      color: var(--tm-fg-dim)

    // 進度條是字元畫的: ████░░░░. 這一版沒有別的東西是圖形,
    // 一條 CSS 畫的色條會是整個畫面上唯一不是字的東西
    .tm-kpi-bar
      display: flex
      align-items: baseline
      gap: 8px
      font-size: 10.5px
      white-space: nowrap
      overflow: hidden
    .tm-kpi-fill
      flex: 0 0 auto
      letter-spacing: -.04em
      color: var(--tm-hot)
    .tm-kpi-note
      flex: 0 0 auto
      color: var(--tm-fg-dim)
      &.up
        color: var(--tm-up)
      &.down
        color: var(--tm-down)
  script: include:lsc index.ls
