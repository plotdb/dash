div(ld-scope)
  .tm-panel(ld="panel")
    .tm-head
      .tm-title(ld="title")
      .tm-sub(ld="sub")
      .tm-spacer
      .tm-hint(ld="hint")
        .tm-hint-pop(ld="hintpop")
      .tm-tag(ld="tag") [FILTERED ✕]
    .tm-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 框是一條 1px 的線, 沒有圓角也沒有陰影 - 終端機畫面上的框是字元畫出來的,
    // 本來就不可能有這些東西
    .tm-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      padding: 7px 10px 8px
      color: var(--tm-fg)
      // 整塊 panel 設等寬字, 圖表裡的 svg text 會跟著繼承 -
      // 跟 report 把整頁換成襯線是同一招
      font-family: var(--tm-mono)
      background: var(--tm-panel)
      border: 1px solid var(--tm-line)
      transition: border-color .15s, background-color .25s

    // 單行: 標題列的高度固定, 所以有沒有副標題、有沒有「篩選中」,
    // 每個框的圖表上緣都對齊
    .tm-head
      flex: 0 0 auto
      display: flex
      align-items: baseline
      gap: 8px
      // 固定高度而不是最小高度: 副標題與「篩選中」的行高跟標題不一樣,
      // 用 min- 的話有沒有它們就差一兩個 px, 同一列卡片的圖表上緣還是會錯開
      height: 18px

    .tm-title
      font-size: 11.5px
      flex: 0 1 auto
      min-width: 0
      font-weight: 700
      letter-spacing: .12em
      text-transform: uppercase
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .tm-spacer
      flex: 1 1 auto

    // 操作提示. 內容由 panel block 依圖表的設定推出來 ( 見 index.ls 的 hints ),
    // 不是宿主在副標題手寫的 - 換一種圖或改一個設定, 提示就跟著改.
    // 篩選中時它讓位給「篩選中 ✕」: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
    .tm-hint
      position: relative
      flex: 0 0 auto
      width: 15px
      height: 15px
      border-radius: 50%
      border: 1px solid var(--tm-line)
      color: var(--tm-fg-dim)
      font-size: 10px
      line-height: 13px
      text-align: center
      cursor: help
      &:before
        content: '?'
      &:hover > .tm-hint-pop
        display: block

    // 彈出來的那一塊刻意往卡片內部開: 格子是 overflow: hidden 的,
    // 往外開會被裁掉
    .tm-hint-pop
      display: none
      position: absolute
      top: 140%
      right: 0
      z-index: 20
      padding: .45em .65em
      font-size: 11px
      line-height: 1.8
      font-weight: normal
      letter-spacing: 0
      text-transform: none
      text-align: left
      white-space: nowrap
      color: var(--tm-fg)
      background: var(--tm-panel)
      border: 1px solid var(--tm-line)
      border-radius: 0
      box-shadow: 0 .4em 1.4em rgba(0,0,0,.22)


    // 狀態也是一行字. 這一版沒有圓角藥丸, 只有方括號
    .tm-tag
      display: none
      flex: 0 0 auto
      font-size: 10.5px
      letter-spacing: .06em
      color: var(--tm-hot)
      cursor: pointer
      &:hover
        color: var(--tm-fg)

    // 副標題跟在標題後面, 空間不夠時先截斷它 ( 標題與右側的狀態不讓 )
    .tm-sub
      flex: 0 100 auto
      min-width: 0
      font-size: 10.5px
      line-height: 1.5
      letter-spacing: .02em
      color: var(--tm-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .tm-body
      flex: 1 1 auto
      min-height: 0
      position: relative
      margin-top: 4px

    .tm-panel.filtering > .tm-head .tm-hint
      display: none

    .tm-panel.filtering
      border-color: var(--tm-hot)
      > .tm-head .tm-tag
        display: block
  script: include:lsc index.ls
