doctype html
html(lang="zh-TW")
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 七種長相, 同一份 def / @plotdb/dash
    //- 模式要在畫面出現之前就寫到 <html> 上, 否則會先閃一下另一個模式的顏色
    script.
      try{var q=new URLSearchParams(location.search).get('mode');var m=(q==='light'||q==='dark')?q:(localStorage.getItem('dash-variation-mode')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));document.documentElement.dataset.mode=m}catch(e){}
    style(type="text/css"): :stylus
      // 入口頁. 七個設計共用一份 def, 這一頁的工作只是把差別講清楚並連過去.
      //
      // 縮圖是真的截圖 ( tool/shot.sh 產生 ), 每個設計 light / dark 各一張,
      // 跟著這一頁的模式換 - 所以這一頁現在長什麼樣, 點進去就是什麼樣.
      //
      // 一開始是用 CSS 畫的 ( 版面比例 + 色票 ), 看得出排版但看不出風格 -
      // 字、線的粗細、圖表本身的長相才是這一組在分的東西
      :root, :root[data-mode=dark]
        --g-bg: #101317
        --g-card: #171c23
        --g-fg: #e8ecf1
        --g-dim: #8893a2
        --g-sub: #96a3b3
        --g-line: rgba(255,255,255,.07)
        --g-line-hi: rgba(255,255,255,.2)
        --g-eyebrow: #5d6b7d
        --g-accent: #8fd3c6
        --g-lede: #aab6c4
        --g-shadow: 0 24px 50px -28px rgba(0,0,0,.9)
      :root[data-mode=light]
        --g-bg: #f1f3f6
        --g-card: #ffffff
        --g-fg: #1b2029
        --g-dim: #6b7484
        --g-sub: #5d6676
        --g-line: rgba(20,25,35,.12)
        --g-line-hi: rgba(20,25,35,.28)
        --g-eyebrow: #939cab
        --g-accent: #0f7a6e
        --g-lede: #4b5361
        --g-shadow: 0 24px 50px -32px rgba(20,25,35,.5)

      html, body
        margin: 0
        padding: 0
        min-height: 100%
      body
        background: var(--g-bg)
        color: var(--g-fg)
        font-family: -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif
        -webkit-font-smoothing: antialiased
        font-size: 14px
        transition: background-color .25s, color .25s

      .g-wrap
        box-sizing: border-box
        max-width: 1320px
        margin: 0 auto
        padding: 56px 32px 80px

      .g-top
        display: flex
        align-items: flex-start
        gap: 20px
      .g-eyebrow
        font-size: 10px
        font-weight: 600
        letter-spacing: .22em
        text-transform: uppercase
        color: var(--g-eyebrow)
      .g-h1
        margin: 10px 0 0
        font-family: "Iowan Old Style", Palatino, "Songti TC", "Noto Serif TC", serif
        font-size: 36px
        font-weight: 600
        line-height: 1.2
      .g-spacer
        flex: 1 1 auto
      .g-mode
        flex: 0 0 auto
        margin-top: 4px
        padding: 7px 15px
        font-size: 12.5px
        color: var(--g-fg)
        background: var(--g-card)
        border: 1px solid var(--g-line)
        border-radius: 999px
        cursor: pointer
        white-space: nowrap
        &:hover
          border-color: var(--g-line-hi)
      .g-lede
        margin-top: 14px
        max-width: 46em
        font-size: 15px
        line-height: 1.85
        color: var(--g-lede)
        code
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 12.5px
          color: var(--g-accent)

      // 兩欄, 不是三欄. 三欄的時候每張縮圖只有 370px 寬, 字跟線都糊掉了 -
      // 而字跟線正是這七版在分的東西
      .g-grid
        display: grid
        grid-template-columns: repeat(2, 1fr)
        gap: 26px
        margin-top: 42px
      @media (max-width: 760px)
        .g-grid
          grid-template-columns: 1fr

      .g-card
        display: flex
        flex-direction: column
        color: inherit
        text-decoration: none
        background: var(--g-card)
        border: 1px solid var(--g-line)
        border-radius: 14px
        overflow: hidden
        transition: transform .2s, border-color .2s, box-shadow .2s
        &:hover
          transform: translateY(-3px)
          border-color: var(--g-line-hi)
          box-shadow: var(--g-shadow)

      // ---- 縮圖. 是真的截圖, 不是 CSS 畫的 ( tool/shot.sh 產生, 存在
      // web/src/raw/assets/shot/ ). 每個設計 light / dark 各一張, 裁成四五個
      // panel 的一塊 - 整頁縮成一格會小到看不出風格, 那正是要看的東西
      .g-shot
        position: relative
        aspect-ratio: 16 / 10
        overflow: hidden
        background: var(--g-bg)
      .g-shot img
        display: block
        width: 100%
        height: 100%
        object-fit: cover
        object-position: left top
      .g-shot .g-dark
        display: none
      :root[data-mode=dark] .g-shot
        .g-light
          display: none
        .g-dark
          display: block

      .g-meta
        flex: 1 1 auto
        display: flex
        flex-direction: column
        gap: 8px
        padding: 18px 20px 22px
        border-top: 1px solid var(--g-line)
      .g-name
        display: flex
        align-items: baseline
        gap: 9px
      .g-id
        font-family: ui-monospace, "SF Mono", monospace
        font-size: 11px
        color: var(--g-dim)
      .g-title
        font-size: 17px
        font-weight: 600
      .g-desc
        font-size: 12.8px
        line-height: 1.75
        color: var(--g-dim)
      .g-points
        margin: 4px 0 0
        padding-left: 1.1em
        font-size: 12.3px
        line-height: 1.8
        color: var(--g-sub)
      .g-go
        margin-top: auto
        padding-top: 12px
        font-size: 12px
        letter-spacing: .04em
        color: var(--g-accent)

      .g-note
        margin-top: 46px
        padding-top: 22px
        max-width: 52em
        font-size: 13px
        line-height: 1.9
        color: var(--g-dim)
        border-top: 1px solid var(--g-line)
        a
          color: var(--g-accent)
          text-decoration: none
          border-bottom: 1px solid var(--g-line-hi)
        code
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 12px
          color: var(--g-accent)
  body
    .g-wrap
      .g-top
        div
          .g-eyebrow @plotdb/dash · initiative / variation
          h1.g-h1 七種長相, 同一份 def
        .g-spacer
        .g-mode(ld="mode")
      .g-lede
        | 下面七個儀表板載入同一份資料、同一批圖表 block、同一套 crossfilter 語意。
        | 每一版換掉的只有三樣東西: <code>panel block</code> 的外觀、一層套在每個 panel 上的
        | <code>cfg</code> 主題, 以及 <code>def.layout</code>。
        | 它們長得不像, 是因為一開始問的問題不一樣。七版都有 light / dark —— 第一次打開時跟著系統走。

      .g-grid
        a.g-card(href="/initiative/variation/vanilla/")
          .g-shot
            img.g-light(src="/assets/shot/vanilla-light.jpg",alt="vanilla 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/vanilla-dark.jpg",alt="vanilla 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id vanilla
              .g-title 素版
            .g-desc 最素的那一份, 也是最早的那一份。它要回答的不是「好不好看」, 而是「一個儀表板由哪些東西組成」。
            ul.g-points
              li 樣式全部來自 <code>dash.css</code>, 頁面只補了一個視窗
              li KPI 是 <code>@makechart/number</code>, 不是自己寫的 block
              li 深色模式只換了 <code>--dash-*</code> 幾個變數
            .g-go 打開 →
        a.g-card(href="/initiative/variation/desk/")
          .g-shot
            img.g-light(src="/assets/shot/desk-light.jpg",alt="desk 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/desk-dark.jpg",alt="desk 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id desk
              .g-title 分析台
            .g-desc 給一個坐在螢幕前面、正在找原因的人。密集、滿版不捲動, 每一格都可以點、可以框選。
            ul.g-points
              li 12 欄格線, KPI 與圖共用同一組欄
              li 色相留給資料, 介面狀態只用亮度
              li def 是右側滑出的抽屜, 可以直接改
            .g-go 打開 →
        a.g-card(href="/initiative/variation/report/")
          .g-shot
            img.g-light(src="/assets/shot/report-light.jpg",alt="report 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/report-dark.jpg",alt="report 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id report
              .g-title 報告
            .g-desc 給一個要把結論讀完的人。版心置中、整頁往下捲, 沒有卡片、沒有陰影, 襯線字從標題一路套到座標軸。
            ul.g-points
              li 行高是絕對值, 高度由內容決定而不是視窗
              li 分隔只有一條細線與留白
              li def 不是抽屜, 是文件最後的附錄
            .g-go 打開 →
        a.g-card(href="/initiative/variation/wall/")
          .g-shot
            img.g-light(src="/assets/shot/wall-light.jpg",alt="wall 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/wall-dark.jpg",alt="wall 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id wall
              .g-title 牆面
            .g-desc 給一個十公尺外走過去的人。磚與磚之間只有 3px 的縫, 數字大到佔滿整格, 狀態用面積而不是小字。
            ul.g-points
              li 色票比其他版飽和一整級, 遠看才分得開
              li x 軸標籤用 auto, 擠不下就自己傾斜
              li 沒有 def 編輯器 — 牆上的螢幕不接鍵盤
            .g-go 打開 →
        a.g-card(href="/initiative/variation/pocket/")
          .g-shot
            img.g-light(src="/assets/shot/pocket-light.jpg",alt="pocket 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/pocket-dark.jpg",alt="pocket 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id pocket
              .g-title 口袋
            .g-desc 給一支手機。一欄到底、整頁往下捲, 主要動作放在拇指構得到的地方, 一次只看一格。
            ul.g-points
              li <code>def.layout.col</code> 從 12 欄變成 2 欄
              li 不開框選 — 拖曳會跟捲動搶同一個手勢
              li def 唯讀。320px 寬不是拿來編輯的
            .g-go 打開 →
        a.g-card(href="/initiative/variation/terminal/")
          .g-shot
            img.g-light(src="/assets/shot/terminal-light.jpg",alt="terminal 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/terminal-dark.jpg",alt="terminal 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id terminal
              .g-title 主控台
            .g-desc 給一個整天開著它的人。整頁等寬字 — 包括圖表裡的文字 — 而且整頁只有一個色相。
            ul.g-points
              li 四個書系是同一個色的四階, 不是四個色相
              li 進度條是字元畫的 ████░░░░
              li 狀態列一行講完: 幾列資料、幾個條件
            .g-go 打開 →
        a.g-card(href="/initiative/variation/rail/")
          .g-shot
            img.g-light(src="/assets/shot/rail-light.jpg",alt="rail 的畫面 ( 淺色 )",loading="lazy",decoding="async")
            img.g-dark(src="/assets/shot/rail-dark.jpg",alt="rail 的畫面 ( 深色 )",loading="lazy",decoding="async")
          .g-meta
            .g-name
              .g-id rail
              .g-title 側欄
            .g-desc 把四個數字立起來。左邊一整欄是指標, 右邊一張主圖佔掉其餘的全部; 一個紅、其餘全是灰階。
            ul.g-points
              li 只改 <code>area</code> 就把 KPI 從一排變成一欄
              li 沒有卡片也沒有框, 標題上的粗線就是分隔
              li 長條圖是全黑的 — 單色圖該用最黑的那個黑
            .g-go 打開 →

      .g-note
        | <code>vanilla</code> 本來是 <code>/initiative/1st/</code>, 現在搬進來當這一組的第一張。
        | 它問的是「一個儀表板由哪些東西組成」, 刻意用最素的樣式;
        | 後面六個問的是接下來那一題: 組成固定下來之後, 長相能換到什麼程度。
        | 七版共用的 light / dark 機制寫在 <code>variation/mode.ls</code>,
        | 各自的理由寫在自己的 <code>README.md</code> 裡。
    //- 這一頁沒有 ldview, 切換鈕自己接. module 會被 defer, 所以等 DOMContentLoaded
    //- ( module 一定在這個事件之前跑完, 此時 dmode 已經在 )
    script.
      addEventListener('DOMContentLoaded', function(){
        var btn = document.querySelector('[ld=mode]');
        btn.addEventListener('click', function(){ dmode.toggle(); });
        dmode.on(function(){ btn.textContent = dmode.icon() + ' ' + dmode.label(); });
      });
    script(type="module"): include:lsc mode.ls
