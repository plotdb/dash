doctype html
html(lang="zh-TW")
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 七種長相, 同一份 def / @plotdb/dash
    //- 模式要在畫面出現之前就寫到 <html> 上, 否則會先閃一下另一個模式的顏色
    script.
      try{var m=localStorage.getItem('dash-variation-mode')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.mode=m}catch(e){}
    style(type="text/css"): :stylus
      // 入口頁. 七個設計共用一份 def, 這一頁的工作只是把差別講清楚並連過去.
      //
      // 縮圖是 CSS 畫的, 不是截圖 - 截圖會過期, 而且這七版的差別本來就是
      // 版面比例與色票, 用幾個 div 就講得完.
      //
      // 縮圖裡的顏色也跟著模式換: 每一張縮圖用的是那個設計自己的色票,
      // 所以這一頁現在長什麼樣, 點進去就是什麼樣
      :root, :root[data-mode=dark]
        --t0-bg: #15171a
        --t0-cell: #1d2024
        --t0-line: #2e3238
        --g-bg: #101317
        --g-card: #171c23
        --g-fg: #e8ecf1
        --g-dim: #8893a2
        --g-sub: #96a3b3
        --g-line: rgba(255,255,255,.07)
        --g-line-hi: rgba(255,255,255,.2)
        --g-eyebrow: #5d6b7d
        --g-accent: #8fd3c6
        --g-lede: #aab6c4
        --g-shadow: 0 24px 50px -28px rgba(0,0,0,.9)
        // 每一張縮圖的三個色: 底、格子、重點
        --t1-bg: #0e1319
        --t1-cell: #1a222d
        --t2-bg: #1c1a17
        --t2-cell: rgba(235,225,205,.06)
        --t2-line: rgba(235,225,205,.45)
        --t3-bg: #0a0a09
        --t3-cell: #1c1a19
        --t3-a: #ffd166
        --t3-b: #26c6a6
        --t3-c: #ff8c61
        --t3-d: #8ab4ff
        --t4-bg: #0b0d12
        --t4-cell: #171a21
        --t4-a: #8ea2ff
        --t5-bg: #0b0b0c
        --t5-cell: #111214
        --t5-line: #262a30
        --t5-a: #ffb000
        --t6-bg: #0c0d10
        --t6-cell: rgba(247,248,250,.14)
        --t6-a: #ff4d60
        --t6-rule: #f7f8fa
      :root[data-mode=light]
        --t0-bg: #f7f8f9
        --t0-cell: #ffffff
        --t0-line: #e7e8e9
        --g-bg: #f1f3f6
        --g-card: #ffffff
        --g-fg: #1b2029
        --g-dim: #6b7484
        --g-sub: #5d6676
        --g-line: rgba(20,25,35,.12)
        --g-line-hi: rgba(20,25,35,.28)
        --g-eyebrow: #939cab
        --g-accent: #0f7a6e
        --g-lede: #4b5361
        --g-shadow: 0 24px 50px -32px rgba(20,25,35,.5)
        --t1-bg: #eef1f6
        --t1-cell: #ffffff
        --t2-bg: #fbfaf7
        --t2-cell: rgba(40,34,24,.055)
        --t2-line: rgba(40,34,24,.4)
        --t3-bg: #c7c2b8
        --t3-cell: #faf8f4
        --t3-a: #c07800
        --t3-b: #00796b
        --t3-c: #c43c22
        --t3-d: #2f5fc0
        --t4-bg: #eef0f4
        --t4-cell: #ffffff
        --t4-a: #3b4bd8
        --t5-bg: #eceae3
        --t5-cell: #f8f7f3
        --t5-line: #c9c6bd
        --t5-a: #9a5e00
        --t6-bg: #ffffff
        --t6-cell: rgba(10,12,15,.10)
        --t6-a: #d7263d
        --t6-rule: #0a0c0f

      html, body
        margin: 0
        padding: 0
        min-height: 100%
      body
        background: var(--g-bg)
        color: var(--g-fg)
        font-family: -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif
        -webkit-font-smoothing: antialiased
        font-size: 14px
        transition: background-color .25s, color .25s

      .g-wrap
        box-sizing: border-box
        max-width: 1200px
        margin: 0 auto
        padding: 56px 32px 80px

      .g-top
        display: flex
        align-items: flex-start
        gap: 20px
      .g-eyebrow
        font-size: 10px
        font-weight: 600
        letter-spacing: .22em
        text-transform: uppercase
        color: var(--g-eyebrow)
      .g-h1
        margin: 10px 0 0
        font-family: "Iowan Old Style", Palatino, "Songti TC", "Noto Serif TC", serif
        font-size: 36px
        font-weight: 600
        line-height: 1.2
      .g-spacer
        flex: 1 1 auto
      .g-mode
        flex: 0 0 auto
        margin-top: 4px
        padding: 7px 15px
        font-size: 12.5px
        color: var(--g-fg)
        background: var(--g-card)
        border: 1px solid var(--g-line)
        border-radius: 999px
        cursor: pointer
        white-space: nowrap
        &:hover
          border-color: var(--g-line-hi)
      .g-lede
        margin-top: 14px
        max-width: 46em
        font-size: 15px
        line-height: 1.85
        color: var(--g-lede)
        code
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 12.5px
          color: var(--g-accent)

      .g-grid
        display: grid
        grid-template-columns: repeat(3, 1fr)
        gap: 22px
        margin-top: 42px
      @media (max-width: 980px)
        .g-grid
          grid-template-columns: repeat(2, 1fr)
      @media (max-width: 680px)
        .g-grid
          grid-template-columns: 1fr

      .g-card
        display: flex
        flex-direction: column
        color: inherit
        text-decoration: none
        background: var(--g-card)
        border: 1px solid var(--g-line)
        border-radius: 14px
        overflow: hidden
        transition: transform .2s, border-color .2s, box-shadow .2s
        &:hover
          transform: translateY(-3px)
          border-color: var(--g-line-hi)
          box-shadow: var(--g-shadow)

      // ---- 縮圖. 每一張都是該設計的版面比例 + 色票, 用 grid 疊出來
      .g-shot
        aspect-ratio: 16 / 10
        padding: 10px
        display: grid
        grid-template-columns: repeat(12, 1fr)
        grid-auto-rows: 1fr
      .g-shot > i
        display: block
        border-radius: 2px

      // vanilla: 四欄、素卡片. 這是其他六版的共同起點
      .g-shot.s0
        gap: 6px
        grid-template-rows: .7fr 1fr 1fr
        background: var(--t0-bg)
      .s0 > i
        background: var(--t0-cell)
        border: 1px solid var(--t0-line)
        border-radius: 3px

      // desk: 有間距、圓角卡片, 12 欄
      .g-shot.s1
        gap: 4px
        grid-template-rows: .7fr 1.1fr 1fr
        background: var(--t1-bg)
      .s1 > i
        background: var(--t1-cell)
        border-radius: 3px
      .s1 > i.k
        border-left: 2px solid currentColor

      // report: 紙、細線分隔、沒有色塊
      .g-shot.s2
        gap: 9px
        grid-template-rows: .6fr 1.2fr 1.1fr
        background: var(--t2-bg)
      .s2 > i
        background: var(--t2-cell)
        border-top: 1px solid var(--t2-line)
        border-radius: 0

      // wall: 色塊拼貼、縫很窄
      .g-shot.s3
        gap: 2px
        grid-template-rows: .7fr 1.2fr 1fr
        background: var(--t3-bg)
        padding: 4px
      .s3 > i
        background: var(--t3-cell)
        border-radius: 0

      // pocket: 一欄. 縮圖裡就是中間那一條
      .g-shot.s4
        gap: 5px
        grid-template-rows: .5fr .5fr 1fr 1fr
        background: var(--t4-bg)
        padding: 8px 0
      .s4 > i
        background: var(--t4-cell)
        border-radius: 6px

      // terminal: 等寬、單色、1px 的框
      .g-shot.s5
        gap: 5px
        grid-template-rows: .6fr 1.2fr 1fr
        background: var(--t5-bg)
      .s5 > i
        background: var(--t5-cell)
        border: 1px solid var(--t5-line)
        border-radius: 0

      // rail: 左側一欄四格, 右邊一張主圖
      .g-shot.s6
        gap: 7px
        grid-template-rows: 1fr 1fr 1.1fr 1.1fr
        background: var(--t6-bg)
      .s6 > i
        background: var(--t6-cell)
        border-radius: 0
      // rail 的格子沒有框, 只有標題上的那條粗線 - 縮圖裡就畫那條線,
      // 底下帶一層淡掉的填色, 不然會看起來像三條浮在空中的線
      .s6 > i.r
        background: linear-gradient(var(--t6-cell), transparent 72%)
        border-top: 2px solid var(--t6-rule)

      .g-meta
        flex: 1 1 auto
        display: flex
        flex-direction: column
        gap: 8px
        padding: 18px 20px 22px
        border-top: 1px solid var(--g-line)
      .g-name
        display: flex
        align-items: baseline
        gap: 9px
      .g-id
        font-family: ui-monospace, "SF Mono", monospace
        font-size: 11px
        color: var(--g-dim)
      .g-title
        font-size: 17px
        font-weight: 600
      .g-desc
        font-size: 12.8px
        line-height: 1.75
        color: var(--g-dim)
      .g-points
        margin: 4px 0 0
        padding-left: 1.1em
        font-size: 12.3px
        line-height: 1.8
        color: var(--g-sub)
      .g-go
        margin-top: auto
        padding-top: 12px
        font-size: 12px
        letter-spacing: .04em
        color: var(--g-accent)

      .g-note
        margin-top: 46px
        padding-top: 22px
        max-width: 52em
        font-size: 13px
        line-height: 1.9
        color: var(--g-dim)
        border-top: 1px solid var(--g-line)
        a
          color: var(--g-accent)
          text-decoration: none
          border-bottom: 1px solid var(--g-line-hi)
        code
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 12px
          color: var(--g-accent)
  body
    .g-wrap
      .g-top
        div
          .g-eyebrow @plotdb/dash · initiative / variation
          h1.g-h1 七種長相, 同一份 def
        .g-spacer
        .g-mode(ld="mode")
      .g-lede
        | 下面七個儀表板載入同一份資料、同一批圖表 block、同一套 crossfilter 語意。
        | 每一版換掉的只有三樣東西: <code>panel block</code> 的外觀、一層套在每個 panel 上的
        | <code>cfg</code> 主題, 以及 <code>def.layout</code>。
        | 它們長得不像, 是因為一開始問的問題不一樣。七版都有 light / dark —— 第一次打開時跟著系統走。

      .g-grid
        a.g-card(href="/initiative/variation/vanilla/")
          .g-shot.s0
            i(style="grid-column:span 3")
            i(style="grid-column:span 3")
            i(style="grid-column:span 3")
            i(style="grid-column:span 3")
            i(style="grid-column:span 6")
            i(style="grid-column:span 6")
            i(style="grid-column:span 3")
            i(style="grid-column:span 6")
            i(style="grid-column:span 3")
          .g-meta
            .g-name
              .g-id vanilla
              .g-title 素版
            .g-desc 最素的那一份, 也是最早的那一份。它要回答的不是「好不好看」, 而是「一個儀表板由哪些東西組成」。
            ul.g-points
              li 樣式全部來自 <code>dash.css</code>, 頁面只補了一個視窗
              li KPI 是 <code>@makechart/number</code>, 不是自己寫的 block
              li 深色模式只換了 <code>--dash-*</code> 幾個變數
            .g-go 打開 →
        a.g-card(href="/initiative/variation/desk/")
          .g-shot.s1
            i.k(style="grid-column:span 3;color:#7f9cf5")
            i.k(style="grid-column:span 3;color:#5ddba4")
            i.k(style="grid-column:span 3;color:#ffd08a")
            i.k(style="grid-column:span 3;color:#4fc3b0")
            i(style="grid-column:span 6")
            i(style="grid-column:span 3")
            i(style="grid-column:span 3;grid-row:span 2")
            i(style="grid-column:span 5")
            i(style="grid-column:span 4")
