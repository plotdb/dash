div(ld-scope)
  .dk-kpi
    .dk-kpi-head
      .dk-kpi-label(ld="label")
      .dk-spacer
      .dk-kpi-note(ld="note")
    .dk-kpi-value
      span.dk-kpi-num(ld="num") 0
      span.dk-kpi-unit(ld="unit")
    .dk-kpi-rail
      .dk-kpi-fill(ld="fill")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    .dk-kpi
      --dk-kpi-accent: #8fa3bb
      position: relative
      flex: 1 1 auto
      min-width: 0
      display: flex
      flex-direction: column
      justify-content: center
      gap: 6px
      padding: 12px 15px 13px
      border-radius: var(--dk-radius)
      background: linear-gradient(180deg, var(--dk-panel-a) 0%, var(--dk-panel-b) 100%)
      border: 1px solid var(--dk-line)
      box-shadow: var(--dk-shadow)
      overflow: hidden
      transition: border-color .2s, background-color .25s
      &:hover
        border-color: var(--dk-line-hi)
      // 左緣的一道色條, 是這張卡片唯一的顏色
      &:before
        content: ''
        position: absolute
        top: 0
        left: 0
        width: 2px
        height: 100%
        background: var(--dk-kpi-accent)
        opacity: .8

    .dk-kpi-head
      display: flex
      align-items: baseline
      gap: 8px

    .dk-kpi-label
      font-size: 11.5px
      letter-spacing: .05em
      color: var(--dk-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .dk-spacer
      flex: 1 1 auto

    .dk-kpi-note
      flex: 0 0 auto
      font-size: 10.5px
      font-variant-numeric: tabular-nums
      color: var(--dk-fg-dim)
      white-space: nowrap
      &.up
        color: var(--dk-up)
      &.down
        color: var(--dk-down)

    .dk-kpi-value
      display: flex
      align-items: baseline
      gap: 6px
      min-width: 0

    .dk-kpi-num
      font-size: 30px
      font-weight: 600
      line-height: 1.1
      letter-spacing: -.01em
      font-variant-numeric: tabular-nums
      color: var(--dk-num)

    .dk-kpi-unit
      font-size: 11.5px
      color: var(--dk-fg-dim)

    // 被篩選選中的比例. 沒有篩選時就是滿格, 所以它一直在, 不會跳出來
    .dk-kpi-rail
      height: 2px
      border-radius: 2px
      background: var(--dk-soft)
      overflow: hidden
    .dk-kpi-fill
      width: 100%
      height: 100%
      border-radius: 2px
      background: var(--dk-kpi-accent)
      opacity: .62
      transition: width .45s cubic-bezier(.22,.8,.3,1)
  script: include:lsc index.ls
