div(ld-scope)
  .dk-panel(ld="panel")
    .dk-head
      .dk-title(ld="title")
      .dk-sub(ld="sub")
      .dk-spacer
      .dk-hint(ld="hint")
        .dk-hint-pop(ld="hintpop")
      .dk-tag(ld="tag")
        i.dk-tag-dot
        span 篩選中
        i.dk-tag-x ✕
    .dk-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    .dk-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      gap: 2px
      padding: 12px 14px 10px
      border-radius: var(--dk-radius)
      color: var(--dk-fg)
      // 外觀全部走頁面定義的 custom property, 所以 light / dark 不必接 JS -
      // 這個 block 的 index.ls 跟其他五個設計逐字相同, 連模式都不知道
      background: linear-gradient(180deg, var(--dk-panel-a) 0%, var(--dk-panel-b) 100%)
      border: 1px solid var(--dk-line)
      box-shadow: var(--dk-shadow)
      transition: border-color .2s, box-shadow .2s, background-color .25s
      &:hover
        border-color: var(--dk-line-hi)

    // 單行: 標題列的高度固定, 所以有沒有副標題、有沒有「篩選中」,
    // 每張卡片的圖表上緣都對齊
    .dk-head
      flex: 0 0 auto
      display: flex
      align-items: center
      gap: 8px
      // 固定高度而不是最小高度: 副標題與「篩選中」的行高跟標題不一樣,
      // 用 min- 的話有沒有它們就差一兩個 px, 同一列卡片的圖表上緣還是會錯開
      height: 23px
      padding-bottom: 6px

    .dk-title
      font-size: 13.5px
      flex: 0 1 auto
      min-width: 0
      font-weight: 600
      letter-spacing: .02em
      color: var(--dk-fg)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    // 副標題跟在標題後面, 空間不夠時先截斷它 ( 標題與右側的狀態不讓 )
    .dk-sub
      flex: 0 100 auto
      min-width: 0
      font-size: 11px
      line-height: 1.5
      color: var(--dk-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .dk-spacer
      flex: 1 1 auto

    // 操作提示. 內容由 panel block 依圖表的設定推出來 ( 見 index.ls 的 hints ),
    // 不是宿主在副標題手寫的 - 換一種圖或改一個設定, 提示就跟著改.
    // 篩選中時它讓位給「篩選中 ✕」: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
    .dk-hint
      position: relative
      flex: 0 0 auto
      width: 15px
      height: 15px
      border-radius: 50%
      border: 1px solid var(--dk-line)
      color: var(--dk-fg-dim)
      font-size: 10px
      line-height: 13px
      text-align: center
      cursor: help
      &:before
        content: '?'
      &:hover > .dk-hint-pop
        display: block

    // 彈出來的那一塊刻意往卡片內部開: 格子是 overflow: hidden 的,
    // 往外開會被裁掉
    .dk-hint-pop
      display: none
      position: absolute
      top: 140%
      right: 0
      z-index: 20
      padding: .45em .65em
      font-size: 11px
      line-height: 1.8
      font-weight: normal
      letter-spacing: 0
      text-transform: none
      text-align: left
      white-space: nowrap
      color: var(--dk-fg)
      background: var(--dk-panel-a)
      border: 1px solid var(--dk-line)
      border-radius: 8px
      box-shadow: 0 .4em 1.4em rgba(0,0,0,.22)


    .dk-body
      flex: 1 1 auto
      min-height: 0
      position: relative

    // 這張圖正在對外發 filter 時的狀態. 用亮度而不是色相 -
    // 色相全部留給資料, 介面狀態不跟資料搶顏色
    .dk-tag
      display: none
      flex: 0 0 auto
      align-items: center
      gap: 5px
      padding: 3px 8px
      font-size: 10.5px
      letter-spacing: .04em
      color: var(--dk-fg)
      background: var(--dk-soft)
      border: 1px solid var(--dk-line)
      border-radius: 999px
      cursor: pointer
      transition: .15s
      &:hover
        background: var(--dk-soft-hi)
        border-color: var(--dk-line-hi)
    .dk-tag-dot
      width: 5px
      height: 5px
      border-radius: 50%
      background: var(--dk-acc-3)
      box-shadow: 0 0 0 3px var(--dk-soft-hi)
    .dk-tag-x
      font-style: normal
      opacity: .55
    .dk-panel.filtering > .dk-head .dk-hint
      display: none

    .dk-panel.filtering
      border-color: var(--dk-line-hi)
      box-shadow: var(--dk-shadow), inset 0 0 0 1px var(--dk-soft)
      > .dk-head .dk-tag
        display: inline-flex
  script: include:lsc index.ls
