doctype html
html(lang="zh-TW")
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 獨立書店銷售概況 / @plotdb/dash
    //- 模式要在畫面出現之前就寫到 <html> 上. index.ls 是 module, 會被 defer 到
    //- DOM 之後, 等它才設屬性會先閃一下另一個模式的顏色
    script.
      try{var q=new URLSearchParams(location.search).get('mode');var m=(q==='light'||q==='dark')?q:(localStorage.getItem('dash-variation-mode')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'));document.documentElement.dataset.mode=m}catch(e){}
    +css([{url: "/css/dash.css"}])
    style(type="text/css"): :stylus
      // 第二版: 同一份框架、同一套 crossfilter, 換一組 panel block 與一層主題.
      // 顏色的規則只有一條 - 色相留給資料, 介面狀態只用亮度.
      //
      // 兩個模式的差別全部收在這一組 custom property 裡, 底下的樣式一律只寫
      // var(--dk-*). block 裡的樣式也是 - block 不是 shadow DOM, custom property
      // 照樣繼承進去, 所以 panel 與 KPI 的外觀不必接任何 JS 就會跟著換.
      //
      // 做不到這件事的只有圖表: 它的顏色在 config 裡, 走 index.ls 的 theme-of.
      :root
        --dk-radius: 12px
        --dash-gap: 14px
      :root, :root[data-mode=dark]
        --dk-bg: #0e1319
        --dk-glow-a: rgba(127,156,245,.10)
        --dk-glow-b: rgba(79,195,176,.09)
        --dk-fg: #e7eef6
        --dk-fg-dim: #7f8d9d
        --dk-fg-strong: #f4f8fc
        --dk-eyebrow: #566477
        --dk-panel-a: #1a222d
        --dk-panel-b: #151c25
        --dk-line: rgba(255,255,255,.10)
        --dk-line-hi: rgba(255,255,255,.22)
        --dk-soft: rgba(255,255,255,.05)
        --dk-soft-hi: rgba(255,255,255,.10)
        --dk-shadow: 0 1px 2px rgba(0,0,0,.35), 0 14px 34px -20px rgba(0,0,0,.9)
        --dk-num: #f3f7fb
        --dk-up: #5ddba4
        --dk-down: #f0a3b4
        --dk-mask: rgba(5,8,12,.62)
        --dk-win: #121a23
        --dk-win-shadow: -24px 0 70px rgba(0,0,0,.6)
        --dk-code: #8fd3c6
        --dk-code-bg: #0d141b
        // KPI 的四道色條. def 裡寫的是 var(--dk-acc-N) 而不是色碼,
        // 所以 KPI block 也不必知道現在是哪個模式
        --dk-acc-1: #7f9cf5
        --dk-acc-2: #5ddba4
        --dk-acc-3: #ffd08a
        --dk-acc-4: #4fc3b0
      // 淺色不是把深色反過來: 卡片提到純白、底色降成冷灰, 陰影換成淡而寬的一層,
      // 資料色相全部壓暗一級 - 同一個藍在白底上要更深才讀得到
      :root[data-mode=light]
        --dk-bg: #eef1f6
        --dk-glow-a: rgba(63,95,214,.07)
        --dk-glow-b: rgba(15,143,134,.06)
        --dk-fg: #253142
        --dk-fg-dim: #6c7a8c
        --dk-fg-strong: #121a24
        --dk-eyebrow: #94a0b2
        --dk-panel-a: #ffffff
        --dk-panel-b: #fbfcfe
        --dk-line: rgba(20,30,45,.13)
        --dk-line-hi: rgba(20,30,45,.30)
        --dk-soft: rgba(20,30,45,.05)
        --dk-soft-hi: rgba(20,30,45,.11)
        --dk-shadow: 0 1px 2px rgba(20,30,45,.07), 0 14px 30px -22px rgba(20,30,45,.45)
        --dk-num: #101822
        --dk-up: #0f8f6b
        --dk-down: #c94f74
        --dk-mask: rgba(30,40,55,.40)
        --dk-win: #ffffff
        --dk-win-shadow: -24px 0 70px rgba(20,30,45,.25)
        --dk-code: #0f7a6e
        --dk-code-bg: #f4f6f9
        --dk-acc-1: #3f5fd6
        --dk-acc-2: #0f9d79
        --dk-acc-3: #c0742a
        --dk-acc-4: #0f8f86

      html, body
        width: 100%
        height: 100%
        margin: 0
        padding: 0
      body
        background: var(--dk-bg)
        color: var(--dk-fg)
        transition: background-color .25s, color .25s
        font-family: -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif
        -webkit-font-smoothing: antialiased
        font-size: 14px

      .dk-page
        box-sizing: border-box
        width: 100%
        height: 100%
        min-height: 620px
        display: flex
        flex-direction: column
        gap: 16px
        padding: 22px 26px 24px
        background: radial-gradient(1100px 560px at 10% -12%, var(--dk-glow-a), transparent 62%), radial-gradient(900px 480px at 94% -4%, var(--dk-glow-b), transparent 58%), var(--dk-bg)

      // ------------------------------------------------------------ 頁首
      .dk-bar
        flex: 0 0 auto
        display: flex
        align-items: flex-end
        gap: 18px
        flex-wrap: wrap
      .dk-eyebrow
        font-size: 10px
        font-weight: 600
        letter-spacing: .2em
        text-transform: uppercase
        color: var(--dk-eyebrow)
      .dk-h1
        margin-top: 3px
        font-family: "Iowan Old Style", Palatino, "Palatino Linotype", "Songti TC", "Noto Serif TC", serif
        font-size: 27px
        font-weight: 600
        line-height: 1.15
        letter-spacing: .015em
        color: var(--dk-fg-strong)
      .dk-h2
        margin-top: 5px
        font-size: 12px
        line-height: 1.5
        color: var(--dk-fg-dim)
      .dk-spacer
        flex: 1 1 auto
      .dk-tools
        display: flex
        align-items: center
        gap: 8px
        flex-wrap: wrap
        justify-content: flex-end
        max-width: 56vw

      .dk-btn
        display: inline-block
        text-decoration: none
        padding: 6px 14px
        font-size: 12.5px
        color: var(--dk-fg)
        background: var(--dk-soft)
        border: 1px solid var(--dk-line)
        border-radius: 999px
        cursor: pointer
        white-space: nowrap
        transition: .15s
        &:hover
          color: var(--dk-fg-strong)
          background: var(--dk-soft-hi)
          border-color: var(--dk-line-hi)
        &.off
          opacity: .3
          pointer-events: none
      .dk-btn.primary
        color: var(--dk-bg)
        background: var(--dk-fg)
        border-color: var(--dk-fg)
        &:hover
          color: var(--dk-bg)
          background: var(--dk-fg-strong)
          border-color: var(--dk-fg-strong)

      // 篩選中的欄位. 跟 panel 的「篩選中」標籤同一套語彙
      .dk-chip
        display: inline-flex
        align-items: center
        gap: 7px
        padding: 5px 7px 5px 11px
        font-size: 11.5px
        color: var(--dk-fg)
        background: var(--dk-soft)
        border: 1px solid var(--dk-line)
        border-radius: 999px
        white-space: nowrap
        max-width: 22em
        .k
          color: var(--dk-fg-dim)
        .v
          overflow: hidden
          text-overflow: ellipsis
        .x
          display: inline-flex
          align-items: center
          justify-content: center
          width: 15px
          height: 15px
          font-size: 9px
          color: var(--dk-fg-dim)
          background: var(--dk-soft-hi)
          border-radius: 50%
          cursor: pointer
          &:hover
            color: var(--dk-bg)
            background: var(--dk-down)

      // ------------------------------------------------------------ 版面
      // .dash / .dash-cell 來自 dash.css, 這裡只加進場動畫
      .dk-board
        flex: 1 1 auto
        min-height: 0
        // dash.css 的 .dash 是 overflow: hidden ( 不讓 svg 撐破格線 ), 但篩選列的
        // 下拉面板一定會超出那一格 - 所以這一頁把它打開. 卡片自己有 overflow:
        // hidden, 圖表還是被各自的卡片關著, 不會跑到版面外面.
        // 有彈出層的儀表板都要做這件事, 不然面板會被裁掉一半
        overflow: visible
      .dash > .dash-cell
        animation: dk-in .55s cubic-bezier(.22,.85,.3,1) both
        &:nth-child(1)
          animation-delay: .00s
        &:nth-child(2)
          animation-delay: .04s
        &:nth-child(3)
          animation-delay: .08s
        &:nth-child(4)
          animation-delay: .12s
        &:nth-child(5)
          animation-delay: .18s
        &:nth-child(6)
          animation-delay: .22s
        &:nth-child(7)
          animation-delay: .28s
        &:nth-child(8)
          animation-delay: .32s
        &:nth-child(9)
          animation-delay: .36s
      @keyframes dk-in
        from
          opacity: 0
          transform: translateY(10px)
        to
          opacity: 1
          transform: none

      // ------------------------------------------------- def 檢視 / 編輯
      .dk-drawer
        position: fixed
        top: 0
        left: 0
        width: 100%
        height: 100%
        z-index: 60
        visibility: hidden
        &.show
          visibility: visible
      .dk-mask
        position: absolute
        width: 100%
        height: 100%
        background: var(--dk-mask)
        opacity: 0
        transition: opacity .25s
      .dk-drawer.show .dk-mask
        opacity: 1
      .dk-win
        box-sizing: border-box
        position: absolute
        top: 0
        right: 0
        height: 100%
        // stylus 會在編譯期算掉 min(), 混單位的結果不是想要的 - 拆成兩行寫
        width: 900px
        max-width: 95vw
        display: flex
        flex-direction: column
        background: var(--dk-win)
        border-left: 1px solid var(--dk-line)
        box-shadow: var(--dk-win-shadow)
        transform: translateX(100%)
        transition: transform .32s cubic-bezier(.28,.84,.3,1)
      .dk-drawer.show .dk-win
        transform: none
      .dk-win-head
        flex: 0 0 auto
        display: flex
        align-items: flex-start
        gap: 10px
        padding: 18px 20px 14px
        border-bottom: 1px solid var(--dk-line)
      .dk-win-title
        font-size: 15px
        font-weight: 600
      .dk-win-body
        flex: 1 1 auto
        min-height: 0
        display: flex
      .dk-side
        box-sizing: border-box
        flex: 0 0 13em
        padding: 10px
        overflow-y: auto
        border-right: 1px solid var(--dk-line)
      .dk-item
        padding: 8px 11px
        border-radius: 8px
        cursor: pointer
        transition: .12s
        .label
          font-size: 12.5px
        .path
          margin-top: 2px
          font-size: 10.5px
          font-family: ui-monospace, "SF Mono", monospace
          color: var(--dk-fg-dim)
        &:hover
          background: var(--dk-soft)
        &.active
          background: var(--dk-soft-hi)
          .path
            color: var(--dk-fg)
      .dk-main
        flex: 1 1 auto
        min-width: 0
        display: flex
        flex-direction: column
        gap: 14px
        padding: 18px 20px
        overflow-y: auto
      .dk-desc
        font-size: 12.8px
        line-height: 1.75
        color: var(--dk-fg)
      .dk-field
        display: flex
        gap: 12px
        padding: 8px 0
        font-size: 12px
        border-top: 1px solid var(--dk-line)
        .key
          flex: 0 0 7em
          font-weight: 600
        .type
          flex: 0 0 14em
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 11.5px
          color: var(--dk-code)
          word-break: break-all
        .desc
          flex: 1 1 auto
          color: var(--dk-fg-dim)
      .dk-editor
        display: flex
        flex-direction: column
        gap: 8px
        textarea
          box-sizing: border-box
          width: 100%
          min-height: 18em
          padding: 12px
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 11.5px
          line-height: 1.65
          color: var(--dk-fg)
          background: var(--dk-code-bg)
          border: 1px solid var(--dk-line)
          border-radius: 8px
          resize: vertical
          &:focus
            outline: none
            border-color: var(--dk-line-hi)
      .dk-foot
        display: flex
        align-items: center
        gap: 10px
      .dk-hint, .dk-msg
        font-size: 11.5px
        color: var(--dk-fg-dim)
  body
    .dk-page
      .dk-bar
        div
          .dk-eyebrow Independent Bookstores · 2024 · Synthetic
          .dk-h1 獨立書店銷售概況
          .dk-h2 @plotdb/dash · desk「分析台」— 密集、滿版不捲動, 可切 light · dark
        .dk-spacer
        .dk-tools
          div(ld="chips",style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end")
          .dk-btn(ld="mode")
          a.dk-btn(href="/initiative/variation/") 其他設計 ↗
          .dk-btn(ld="clear") 清除篩選
          .dk-btn.primary(ld="open-def") 儀表板定義
      .dk-board(ld="board")

    .dk-drawer(ld="defv")
      .dk-mask(ld="close-def")
      .dk-win
        .dk-win-head
          div
            .dk-win-title 儀表板定義 ( def )
            .dk-h2 一份 def 就是一個儀表板. 左側是要定義的東西, 右側可以直接改, 套用後立刻重建.
          .dk-spacer
          .dk-btn(ld="close-def") 關閉
        .dk-win-body
          .dk-side: .dk-item(ld-each="group")
            .label(ld="label")
            .path(ld="path")
          .dk-main
            .dk-desc(ld="desc")
            div
              .dk-field(ld-each="field")
                .key(ld="key")
                .type(ld="type")
                .desc(ld="fdesc")
            .dk-editor
              .dk-hint(ld="hint")
              textarea(ld="editor",spellcheck="false")
              .dk-foot
                .dk-btn.primary(ld="apply") 套用並重建
                .dk-btn(ld="reset") 還原
                .dk-msg(ld="msg")
    +script([
      {name: "proxise"},
      {name: "@loadingio/debounce.js"},
      {name: "@loadingio/ldquery"},
      {name: "@plotdb/semver"},
      {name: "@plotdb/csscope"},
      {name: "@plotdb/rescope"},
      {name: "@plotdb/block"},
      {name: "ldview"},
      {name: "papaparse", path: "papaparse.min.js"},
      {url: "/js/dash.js"}
    ])
    script(type="module"): include:lsc ../mode.ls
    script(type="module"): include:lsc index.ls
