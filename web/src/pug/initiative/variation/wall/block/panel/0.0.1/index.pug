div(ld-scope)
  .wl-panel(ld="panel")
    .wl-head
      .wl-title(ld="title")
      .wl-sub(ld="sub")
      .wl-spacer
      .wl-hint(ld="hint")
        .wl-hint-pop(ld="hintpop")
      .wl-tag(ld="tag")
        i.wl-tag-dot
        span(t="Filtering")
    .wl-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 牆面版的磚: 沒有圓角、沒有陰影、沒有邊框, 整塊實色.
    // 分隔靠的是格子之間那 3px 的縫, 不是卡片的輪廓 -
    // 遠看的時候輪廓線根本看不見, 看得見的是色塊的邊界
    .wl-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      padding: 16px 18px 12px
      color: var(--wl-fg)
      background: var(--wl-tile)
      font-family: var(--wl-sans)

    // 單行: 標題列的高度固定 ( 不換行 ), 所以有沒有副標題、有沒有「篩選中」,
    // 每張磚的圖表上緣都對齊. 右側留給狀態與操作
    .wl-head
      flex: 0 0 auto
      display: flex
      align-items: baseline
      gap: 10px
      // 固定高度而不是最小高度: 副標題與「篩選中」的行高跟標題不一樣,
      // 用 min- 的話有沒有它們就差一兩個 px, 同一列卡片的圖表上緣還是會錯開
      height: 20px

    // 大寫、緊排、粗 - 遠處要先讀到的是這一行
    .wl-title
      font-size: 13px
      flex: 0 1 auto
      min-width: 0
      font-weight: 800
      letter-spacing: .13em
      text-transform: uppercase
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .wl-spacer
      flex: 1 1 auto

    // 操作提示. 內容由 panel block 依圖表的設定推出來 ( 見 index.ls 的 hints ),
    // 不是宿主在副標題手寫的 - 換一種圖或改一個設定, 提示就跟著改.
    // 篩選中時它讓位給「篩選中 ✕」: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
    .wl-hint
      position: relative
      flex: 0 0 auto
      width: 15px
      height: 15px
      border-radius: 50%
      border: 1px solid var(--wl-edge)
      color: var(--wl-fg-dim)
      font-size: 10px
      line-height: 13px
      text-align: center
      cursor: help
      &:before
        content: '?'
      &:hover > .wl-hint-pop
        display: block

    // 彈出來的那一塊刻意往卡片內部開: 格子是 overflow: hidden 的,
    // 往外開會被裁掉
    .wl-hint-pop
      display: none
      position: absolute
      top: 140%
      right: 0
      z-index: 20
      padding: .45em .65em
      font-size: 11px
      line-height: 1.8
      font-weight: normal
      letter-spacing: 0
      text-transform: none
      text-align: left
      white-space: nowrap
      color: var(--wl-fg)
      background: var(--wl-tile)
      border: 1px solid var(--wl-edge)
      border-radius: 0
      box-shadow: 0 .4em 1.4em rgba(0,0,0,.22)


    // 說明文字排在標題右邊而不是下面 - 牆面上的垂直空間要留給圖
    // 副標題跟在標題後面, 空間不夠時先截斷它 ( 標題與右側的狀態不讓 )
    .wl-sub
      flex: 0 100 auto
      min-width: 0
      font-size: 11px
      letter-spacing: .02em
      color: var(--wl-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .wl-body
      flex: 1 1 auto
      min-height: 0
      position: relative
      margin-top: 8px

    // 篩選中: 整塊磚的上緣換成一道粗的強調色.
    // 遠看只看得到「哪幾塊亮起來了」, 看不到小字 - 所以狀態要用面積表示
    .wl-tag
      display: none
      flex: 0 0 auto
      align-items: center
      gap: 6px
      font-size: 10.5px
      font-weight: 700
      letter-spacing: .1em
      text-transform: uppercase
      color: var(--wl-hot)
      cursor: pointer
      &:hover
        opacity: .7
    .wl-tag-dot
      width: 7px
      height: 7px
      background: var(--wl-hot)

    .wl-panel.filtering > .wl-head .wl-hint
      display: none

    .wl-panel.filtering
      box-shadow: inset 0 4px 0 0 var(--wl-hot)
      > .wl-head .wl-tag
        display: inline-flex
  script: include:lsc index.ls
