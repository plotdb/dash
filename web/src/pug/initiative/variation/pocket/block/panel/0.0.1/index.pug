div(ld-scope)
  .pk-panel(ld="panel")
    .pk-head
      .pk-title(ld="title")
      .pk-spacer
      .pk-hint(ld="hint")
        .pk-hint-pop(ld="hintpop")
      .pk-tag(ld="tag") 篩選中 ✕
    .pk-sub(ld="sub")
    .pk-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 手機上一格就是一整排, 卡片的左右邊界就是版心的左右邊界 -
    // 所以卡片不必再畫邊框, 只要跟底色分開就夠了
    .pk-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      padding: 14px 14px 10px
      border-radius: 16px
      color: var(--pk-fg)
      background: var(--pk-card)
      transition: background-color .25s

    .pk-head
      flex: 0 0 auto
      display: flex
      align-items: center
      gap: 8px

    .pk-title
      font-size: 15px
      font-weight: 600
      letter-spacing: .01em
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .pk-spacer
      flex: 1 1 auto

    // 手指的目標: 32px 高, 跟頁尾那排按鈕同一個尺寸.
    // 滑鼠的 hover 在這裡不存在, 所以狀態只能靠看得見的東西說
    .pk-tag
      display: none
      flex: 0 0 auto
      align-items: center
      gap: 6px
      height: 32px
      padding: 0 13px
      font-size: 12px
      color: var(--pk-on-accent)
      background: var(--pk-accent)
      border-radius: 999px
      cursor: pointer

    // 操作提示. 內容由 panel block 依圖表宣告的互動推出來 ( 見 index.ls 的 hints ).
    // 圓圈比桌機大一號: 手指的目標不能用滑鼠的尺寸
    .pk-hint
      position: relative
      flex: 0 0 auto
      width: 20px
      height: 20px
      border-radius: 50%
      border: 1px solid var(--pk-line)
      color: var(--pk-fg-dim)
      font-size: 12px
      line-height: 18px
      text-align: center
      cursor: help
      &:before
        content: '?'
      // 手機沒有 hover, 所以靠點一下 ( :focus-within 由 tabindex 之外的點擊觸發不了,
      // 但 :active 會 ) - 兩個都掛上, 桌機瀏覽器開這一頁時 hover 照樣有效
      &:hover > .pk-hint-pop, &:active > .pk-hint-pop
        display: block

    .pk-hint-pop
      display: none
      position: absolute
      top: 140%
      right: 0
      z-index: 20
      padding: .5em .7em
      font-size: 12px
      line-height: 1.8
      font-weight: normal
      text-align: left
      white-space: nowrap
      color: var(--pk-fg)
      background: var(--pk-card)
      border: 1px solid var(--pk-line)
      border-radius: 10px
      box-shadow: 0 .4em 1.4em rgba(0,0,0,.22)

    .pk-sub
      flex: 0 0 auto
      margin-top: 3px
      font-size: 12px
      line-height: 1.5
      color: var(--pk-fg-dim)

    .pk-body
      flex: 1 1 auto
      min-height: 0
      position: relative
      margin-top: 6px

    .pk-panel.filtering
      > .pk-head .pk-tag
        display: inline-flex
      // 篩選中時提示讓位: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
      > .pk-head .pk-hint
        display: none
  script: include:lsc index.ls
