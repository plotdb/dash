div(ld-scope)
  .dash-panel(ld="panel")
    .dash-head
      .dash-title(ld="title")
      .dash-sub(ld="sub")
      .dash-spacer
      .dash-hint(ld="hint")
        .dash-hint-pop(ld="hintpop")
      .dash-tag(ld="tag")
        span(t="Filtering")
        |  ✕
    .dash-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
  script: include:lsc index.ls
