div(ld-scope)
  .rp-panel(ld="panel")
    .rp-rule
    .rp-head
      .rp-title(ld="title")
      .rp-sub(ld="sub")
      .rp-spacer
      .rp-hint(ld="hint")
        .rp-hint-pop(ld="hintpop")
      .rp-tag(ld="tag") 篩選中 ✕
    .rp-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 報告版的卡片是「沒有卡片」. 分隔靠的是一條細線與留白,
    // 不是邊框、圓角與陰影 - 印出來的東西沒有陰影
    .rp-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      color: var(--rp-ink)
      // 圖表的文字會繼承這裡的 font-family ( svg text 也吃 CSS 繼承 ),
      // 所以軸標籤、legend 跟標題是同一套字
      font-family: var(--rp-serif)
      background: none
      border: none

    // 標題上面那一條. filtering 時整條換色加粗 - 這一版沒有別的地方可以變
    .rp-rule
      flex: 0 0 auto
      height: 1px
      background: var(--rp-line)
      transition: background .18s, height .18s

    // 單行: 標題列的高度固定, 所以有沒有副標題、有沒有「篩選中」,
    // 每張卡片的圖表上緣都對齊
    .rp-head
      flex: 0 0 auto
      display: flex
      align-items: baseline
      gap: 10px
      // 固定高度而不是最小高度: 副標題與「篩選中」的行高跟標題不一樣,
      // 用 min- 的話有沒有它們就差一兩個 px, 同一列卡片的圖表上緣還是會錯開
      height: 24px
      padding-top: 9px

    .rp-title
      font-size: 15.5px
      flex: 0 1 auto
      min-width: 0
      font-weight: 600
      letter-spacing: .02em
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .rp-spacer
      flex: 1 1 auto

    // 操作提示. 內容由 panel block 依圖表的設定推出來 ( 見 index.ls 的 hints ),
    // 不是宿主在副標題手寫的 - 換一種圖或改一個設定, 提示就跟著改.
    // 篩選中時它讓位給「篩選中 ✕」: 那時候使用者要的是怎麼取消, 不是可以怎麼篩
    .rp-hint
      position: relative
      flex: 0 0 auto
      width: 15px
      height: 15px
      border-radius: 50%
      border: 1px solid var(--rp-line)
      color: var(--rp-ink-dim)
      font-size: 10px
      line-height: 13px
      text-align: center
      cursor: help
      &:before
        content: '?'
      &:hover > .rp-hint-pop
        display: block

    // 彈出來的那一塊刻意往卡片內部開: 格子是 overflow: hidden 的,
    // 往外開會被裁掉
    .rp-hint-pop
      display: none
      position: absolute
      top: 140%
      right: 0
      z-index: 20
      padding: .45em .65em
      font-size: 11px
      line-height: 1.8
      font-weight: normal
      letter-spacing: 0
      text-transform: none
      text-align: left
      white-space: nowrap
      color: var(--rp-text)
      background: var(--rp-paper)
      border: 1px solid var(--rp-line)
      border-radius: 2px
      box-shadow: 0 .4em 1.4em rgba(0,0,0,.22)


    // 說明文字單獨一行, 用斜體 - 報告的圖說就長這樣
    // 副標題跟在標題後面, 空間不夠時先截斷它 ( 標題與右側的狀態不讓 )
    .rp-sub
      flex: 0 100 auto
      min-width: 0
      font-size: 11.5px
      font-style: italic
      line-height: 1.5
      color: var(--rp-ink-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .rp-body
      flex: 1 1 auto
      min-height: 0
      position: relative
      padding-top: 6px

    // 「篩選中」是一段加底線的文字, 不是藥丸按鈕
    .rp-tag
      display: none
      flex: 0 0 auto
      font-size: 11px
      font-style: italic
      color: var(--rp-accent)
      border-bottom: 1px solid currentColor
      cursor: pointer
      white-space: nowrap
      &:hover
        opacity: .7

    .rp-panel.filtering > .rp-head .rp-hint
      display: none

    .rp-panel.filtering
      > .rp-rule
        height: 2px
        background: var(--rp-accent)
      > .rp-head .rp-tag
        display: inline-block
  script: include:lsc index.ls
