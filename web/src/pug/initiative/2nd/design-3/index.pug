doctype html
html(lang="zh-TW")
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 獨立書店銷售概況 — 值班畫面 / @plotdb/dash
    //- 模式要在畫面出現之前就寫到 <html> 上, 否則會先閃一下另一個模式的顏色
    script.
      try{var m=localStorage.getItem('dash-2nd-mode')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.mode=m}catch(e){}
    +css([{url: "/css/dash.css"}])
    style(type="text/css"): :stylus
      // design-3「牆面」. 假設沒有人坐在螢幕前面.
      //
      // 這一版沒有留白. 磚與磚之間只有 3px 的縫, 縫的顏色就是頁面底色 -
      // 所以整面看起來是一張拼起來的板子, 不是一堆浮在底色上的卡片.
      :root
        --wl-sans: "Helvetica Neue", -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif
        --dash-gap: 3px
      // 深色是這一版的預設: 牆上的螢幕通常在一個比它暗的空間裡.
      // 淺色版是同一面牆在大白天的樣子 - 磚提到接近白, 縫反而變成比磚深的一條線
      // ( 縫永遠要比磚暗, 不然拼貼會散掉 ), 海報色票整組壓暗一級才壓得住白底
      :root, :root[data-mode=dark]
        --wl-bg: #0a0a09
        --wl-tile: #1c1a19
        --wl-fg: #f2efe9
        --wl-fg-dim: #8d867d
        --wl-edge: rgba(255,255,255,.2)
        --wl-hot: #ffd166
        // 色塊上的字. 跟 --wl-hot / --wl-acc-* 是一組的, 底色一換就要跟著換
        --wl-on-hot: #0d0c0b
        --wl-on-acc: #0d0c0b
        --wl-shade: rgba(0,0,0,.16)
        --wl-shade-hi: rgba(0,0,0,.52)
        --wl-acc-1: #ffd166
        --wl-acc-2: #26c6a6
        --wl-acc-3: #ff8c61
        --wl-acc-4: #8ab4ff
      :root[data-mode=light]
        --wl-bg: #c7c2b8
        --wl-tile: #faf8f4
        --wl-fg: #15130f
        --wl-fg-dim: #6e675e
        --wl-edge: rgba(0,0,0,.22)
        --wl-hot: #e0531f
        --wl-on-hot: #fff8f2
        --wl-on-acc: #fffaf4
        --wl-shade: rgba(255,255,255,.22)
        --wl-shade-hi: rgba(255,255,255,.62)
        --wl-acc-1: #c07800
        --wl-acc-2: #00796b
        --wl-acc-3: #c43c22
        --wl-acc-4: #2f5fc0

      html, body
        width: 100%
        height: 100%
        margin: 0
        padding: 0
      body
        background: var(--wl-bg)
        color: var(--wl-fg)
        transition: background-color .25s, color .25s
        font-family: var(--wl-sans)
        -webkit-font-smoothing: antialiased
        font-size: 14px
        overflow: hidden

      .wl-screen
        box-sizing: border-box
        width: 100%
        height: 100%
        min-height: 560px
        display: flex
        flex-direction: column
        gap: 3px
        padding: 3px

      // ------------------------------------------------------------ 頁首
      // 頁首也是一塊磚, 不是浮在上面的工具列. 高度壓到最低 - 牆面上
      // 每一個像素的高度都該給圖
      .wl-bar
        flex: 0 0 auto
        display: flex
        align-items: center
        gap: 16px
        padding: 0 18px
        height: 52px
        background: var(--wl-tile)
      .wl-brand
        display: flex
        align-items: baseline
        gap: 12px
        min-width: 0
      .wl-mark
        width: 10px
        height: 10px
        background: var(--wl-hot)
      .wl-h1
        font-size: 16px
        font-weight: 800
        letter-spacing: .16em
        text-transform: uppercase
        white-space: nowrap
      .wl-h2
        font-size: 11px
        letter-spacing: .1em
        text-transform: uppercase
        color: var(--wl-fg-dim)
        white-space: nowrap
      .wl-spacer
        flex: 1 1 auto

      .wl-chips
        display: flex
        align-items: center
        gap: 10px
        flex-wrap: nowrap
        overflow: hidden
      .wl-chip
        display: inline-flex
        align-items: baseline
        gap: 7px
        padding: 4px 10px
        font-size: 11.5px
        font-weight: 600
        color: var(--wl-on-hot)
        background: var(--wl-hot)
        white-space: nowrap
        .k
          font-weight: 700
          opacity: .55

      .wl-btn
        flex: 0 0 auto
        padding: 6px 13px
        font-size: 11px
        font-weight: 700
        letter-spacing: .1em
        text-transform: uppercase
        color: var(--wl-fg)
        background: none
        border: 1px solid var(--wl-edge)
        cursor: pointer
        white-space: nowrap
        &:hover
          color: var(--wl-tile)
          background: var(--wl-fg)
          border-color: var(--wl-fg)
        &.off
          opacity: .22
          pointer-events: none
      .wl-link
        flex: 0 0 auto
        font-size: 11px
        letter-spacing: .1em
        text-transform: uppercase
        color: var(--wl-fg-dim)
        text-decoration: none
        white-space: nowrap
        &:hover
          color: var(--wl-fg)

      // ------------------------------------------------------------ 版面
      .wl-board
        flex: 1 1 auto
        min-height: 0
      // 磚是一塊一塊亮起來的. 間隔比 design-1 短 - 牆面的畫面會重複被看到,
      // 慢的進場第二次看就是在等
      .dash > .dash-cell
        animation: wl-in .4s cubic-bezier(.2,.8,.3,1) both
        &:nth-child(1)
          animation-delay: .00s
        &:nth-child(2)
          animation-delay: .03s
        &:nth-child(3)
          animation-delay: .06s
        &:nth-child(4)
          animation-delay: .09s
        &:nth-child(5)
          animation-delay: .13s
        &:nth-child(6)
          animation-delay: .16s
        &:nth-child(7)
          animation-delay: .19s
        &:nth-child(8)
          animation-delay: .22s
        &:nth-child(9)
          animation-delay: .25s
      @keyframes wl-in
        from
          opacity: 0
          transform: scale(.985)
        to
          opacity: 1
          transform: none
  body
    .wl-screen
      .wl-bar
        .wl-brand
          .wl-mark
          .wl-h1 獨立書店銷售概況
          .wl-h2 2024 · Synthetic
        .wl-spacer
        .wl-chips(ld="chips")
        .wl-btn(ld="mode")
        .wl-btn(ld="clear") 清除篩選
        a.wl-link(href="/initiative/2nd/") 其他設計 ↗
      .wl-board(ld="board")
    +script([
      {name: "proxise"},
      {name: "@loadingio/debounce.js"},
      {name: "@loadingio/ldquery"},
      {name: "@plotdb/semver"},
      {name: "@plotdb/csscope"},
      {name: "@plotdb/rescope"},
      {name: "@plotdb/block"},
      {name: "ldview"},
      {name: "papaparse", path: "papaparse.min.js"},
      {url: "/js/dash.js"}
    ])
    script(type="module"): include:lsc ../mode.ls
    script(type="module"): include:lsc index.ls
