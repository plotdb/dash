div
  .wl-kpi
    .wl-kpi-head
      .wl-kpi-label(ld="label")
      .wl-spacer
      .wl-kpi-note(ld="note")
    .wl-kpi-value
      span.wl-kpi-num(ld="num") 0
      span.wl-kpi-unit(ld="unit")
    .wl-kpi-rail
      .wl-kpi-fill(ld="fill")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 整塊磚就是這個指標. 顏色不是裝飾, 是「這一格講的是哪件事」的標籤
    .wl-kpi
      --wl-kpi-accent: #8a8f98
      position: relative
      flex: 1 1 auto
      min-width: 0
      display: flex
      flex-direction: column
      justify-content: space-between
      padding: 15px 18px 0
      font-family: var(--wl-sans)
      color: #0d0c0b
      background: var(--wl-kpi-accent)
      overflow: hidden

    .wl-kpi-head
      display: flex
      align-items: baseline
      gap: 8px

    .wl-kpi-label
      font-size: 11.5px
      font-weight: 800
      letter-spacing: .14em
      text-transform: uppercase
      opacity: .72
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .wl-spacer
      flex: 1 1 auto

    .wl-kpi-note
      flex: 0 0 auto
      font-size: 11px
      font-weight: 600
      font-variant-numeric: tabular-nums
      opacity: .66
      white-space: nowrap

    .wl-kpi-value
      display: flex
      align-items: baseline
      gap: 7px
      min-width: 0
      padding-bottom: 10px

    // 牆上要看的就是這個數字, 所以它可以大到接近格子的高度.
    // 用 clamp 跟著格子縮 - 牆面螢幕的解析度不是固定的
    .wl-kpi-num
      font-size: clamp(30px, 3.4vw, 58px)
      font-weight: 800
      line-height: 1
      letter-spacing: -.03em
      font-variant-numeric: tabular-nums

    .wl-kpi-unit
      font-size: 12px
      font-weight: 700
      opacity: .6

    // 底下那一道就是「篩選選中了全體的多少」. 夠粗, 遠看也讀得到
    .wl-kpi-rail
      flex: 0 0 auto
      height: 7px
      background: rgba(0,0,0,.16)
    .wl-kpi-fill
      width: 100%
      height: 100%
      background: rgba(0,0,0,.52)
      transition: width .5s cubic-bezier(.22,.8,.3,1)
  script: include:lsc index.ls
