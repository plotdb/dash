div
  .ed-panel
    .ed-head
      .ed-rule
      .ed-titles
        .ed-title(ld="title")
        .ed-sub(ld="sub")
      .ed-spacer
      .ed-tag(ld="tag") 篩選中 ✕
    .ed-body(ld="body")
  style(type="text/css"): :stylus
    :scope
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex

    // 沒有卡片, 也沒有框. 每一格的上緣是一條粗線 -
    // 粗線是標題的一部分, 不是分隔線: 它跟標題一起構成「這是一節的開頭」
    .ed-panel
      position: relative
      flex: 1 1 auto
      min-width: 0
      min-height: 0
      display: flex
      flex-direction: column
      color: var(--ed-fg)

    .ed-head
      flex: 0 0 auto
      display: flex
      align-items: baseline
      gap: 10px
      flex-wrap: wrap
      padding-bottom: 8px

    .ed-rule
      flex: 0 0 100%
      height: 3px
      margin-bottom: 9px
      background: var(--ed-fg-strong)
      transition: background-color .2s

    .ed-titles
      min-width: 0
    .ed-title
      font-size: 17px
      font-weight: 700
      letter-spacing: -.01em
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis
    .ed-sub
      margin-top: 2px
      font-size: 11.5px
      line-height: 1.5
      color: var(--ed-fg-dim)
      white-space: nowrap
      overflow: hidden
      text-overflow: ellipsis

    .ed-spacer
      flex: 1 1 auto

    .ed-tag
      display: none
      flex: 0 0 auto
      padding: 2px 9px
      font-size: 11px
      font-weight: 600
      color: var(--ed-on-accent)
      background: var(--ed-accent)
      cursor: pointer

    .ed-body
      flex: 1 1 auto
      min-height: 0
      position: relative

    // 篩選中 = 那條粗線換成強調色. 這一版沒有邊框可以亮, 只有這條線
    .ed-panel.filtering
      > .ed-head
        .ed-rule
          background: var(--ed-accent)
        .ed-tag
          display: block
  script: include:lsc index.ls
