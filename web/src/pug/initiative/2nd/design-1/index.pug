doctype html
html(lang="zh-TW")
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 獨立書店銷售概況 / @plotdb/dash
    //- 模式要在畫面出現之前就寫到 <html> 上. index.ls 是 module, 會被 defer 到
    //- DOM 之後, 等它才設屬性會先閃一下另一個模式的顏色
    script.
      try{var m=localStorage.getItem('dash-2nd-mode')||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');document.documentElement.dataset.mode=m}catch(e){}
    +css([{url: "/css/dash.css"}])
    style(type="text/css"): :stylus
      // 第二版: 同一份框架、同一套 crossfilter, 換一組 panel block 與一層主題.
      // 顏色的規則只有一條 - 色相留給資料, 介面狀態只用亮度.
      //
      // 兩個模式的差別全部收在這一組 custom property 裡, 底下的樣式一律只寫
      // var(--n2-*). block 裡的樣式也是 - block 不是 shadow DOM, custom property
      // 照樣繼承進去, 所以 panel 與 KPI 的外觀不必接任何 JS 就會跟著換.
      //
      // 做不到這件事的只有圖表: 它的顏色在 config 裡, 走 index.ls 的 theme-of.
      :root
        --n2-radius: 12px
        --dash-gap: 14px
      :root, :root[data-mode=dark]
        --n2-bg: #0e1319
        --n2-glow-a: rgba(127,156,245,.10)
        --n2-glow-b: rgba(79,195,176,.09)
        --n2-fg: #e7eef6
        --n2-fg-dim: #7f8d9d
        --n2-fg-strong: #f4f8fc
        --n2-eyebrow: #566477
        --n2-panel-a: #1a222d
        --n2-panel-b: #151c25
        --n2-line: rgba(255,255,255,.10)
        --n2-line-hi: rgba(255,255,255,.22)
        --n2-soft: rgba(255,255,255,.05)
        --n2-soft-hi: rgba(255,255,255,.10)
        --n2-shadow: 0 1px 2px rgba(0,0,0,.35), 0 14px 34px -20px rgba(0,0,0,.9)
        --n2-num: #f3f7fb
        --n2-up: #5ddba4
        --n2-down: #f0a3b4
        --n2-mask: rgba(5,8,12,.62)
        --n2-win: #121a23
        --n2-win-shadow: -24px 0 70px rgba(0,0,0,.6)
        --n2-code: #8fd3c6
        --n2-code-bg: #0d141b
        // KPI 的四道色條. def 裡寫的是 var(--n2-acc-N) 而不是色碼,
        // 所以 KPI block 也不必知道現在是哪個模式
        --n2-acc-1: #7f9cf5
        --n2-acc-2: #5ddba4
        --n2-acc-3: #ffd08a
        --n2-acc-4: #4fc3b0
      // 淺色不是把深色反過來: 卡片提到純白、底色降成冷灰, 陰影換成淡而寬的一層,
      // 資料色相全部壓暗一級 - 同一個藍在白底上要更深才讀得到
      :root[data-mode=light]
        --n2-bg: #eef1f6
        --n2-glow-a: rgba(63,95,214,.07)
        --n2-glow-b: rgba(15,143,134,.06)
        --n2-fg: #253142
        --n2-fg-dim: #6c7a8c
        --n2-fg-strong: #121a24
        --n2-eyebrow: #94a0b2
        --n2-panel-a: #ffffff
        --n2-panel-b: #fbfcfe
        --n2-line: rgba(20,30,45,.13)
        --n2-line-hi: rgba(20,30,45,.30)
        --n2-soft: rgba(20,30,45,.05)
        --n2-soft-hi: rgba(20,30,45,.11)
        --n2-shadow: 0 1px 2px rgba(20,30,45,.07), 0 14px 30px -22px rgba(20,30,45,.45)
        --n2-num: #101822
        --n2-up: #0f8f6b
        --n2-down: #c94f74
        --n2-mask: rgba(30,40,55,.40)
        --n2-win: #ffffff
        --n2-win-shadow: -24px 0 70px rgba(20,30,45,.25)
        --n2-code: #0f7a6e
        --n2-code-bg: #f4f6f9
        --n2-acc-1: #3f5fd6
        --n2-acc-2: #0f9d79
        --n2-acc-3: #c0742a
        --n2-acc-4: #0f8f86

      html, body
        width: 100%
        height: 100%
        margin: 0
        padding: 0
      body
        background: var(--n2-bg)
        color: var(--n2-fg)
        transition: background-color .25s, color .25s
        font-family: -apple-system, "PingFang TC", "Noto Sans TC", system-ui, sans-serif
        -webkit-font-smoothing: antialiased
        font-size: 14px

      .n2-page
        box-sizing: border-box
        width: 100%
        height: 100%
        min-height: 620px
        display: flex
        flex-direction: column
        gap: 16px
        padding: 22px 26px 24px
        background: radial-gradient(1100px 560px at 10% -12%, var(--n2-glow-a), transparent 62%), radial-gradient(900px 480px at 94% -4%, var(--n2-glow-b), transparent 58%), var(--n2-bg)

      // ------------------------------------------------------------ 頁首
      .n2-bar
        flex: 0 0 auto
        display: flex
        align-items: flex-end
        gap: 18px
        flex-wrap: wrap
      .n2-eyebrow
        font-size: 10px
        font-weight: 600
        letter-spacing: .2em
        text-transform: uppercase
        color: var(--n2-eyebrow)
      .n2-h1
        margin-top: 3px
        font-family: "Iowan Old Style", Palatino, "Palatino Linotype", "Songti TC", "Noto Serif TC", serif
        font-size: 27px
        font-weight: 600
        line-height: 1.15
        letter-spacing: .015em
        color: var(--n2-fg-strong)
      .n2-h2
        margin-top: 5px
        font-size: 12px
        line-height: 1.5
        color: var(--n2-fg-dim)
      .n2-spacer
        flex: 1 1 auto
      .n2-tools
        display: flex
        align-items: center
        gap: 8px
        flex-wrap: wrap
        justify-content: flex-end
        max-width: 56vw

      .n2-btn
        display: inline-block
        text-decoration: none
        padding: 6px 14px
        font-size: 12.5px
        color: var(--n2-fg)
        background: var(--n2-soft)
        border: 1px solid var(--n2-line)
        border-radius: 999px
        cursor: pointer
        white-space: nowrap
        transition: .15s
        &:hover
          color: var(--n2-fg-strong)
          background: var(--n2-soft-hi)
          border-color: var(--n2-line-hi)
        &.off
          opacity: .3
          pointer-events: none
      .n2-btn.primary
        color: var(--n2-bg)
        background: var(--n2-fg)
        border-color: var(--n2-fg)
        &:hover
          color: var(--n2-bg)
          background: var(--n2-fg-strong)
          border-color: var(--n2-fg-strong)

      // 篩選中的欄位. 跟 panel 的「篩選中」標籤同一套語彙
      .n2-chip
        display: inline-flex
        align-items: center
        gap: 7px
        padding: 5px 7px 5px 11px
        font-size: 11.5px
        color: var(--n2-fg)
        background: var(--n2-soft)
        border: 1px solid var(--n2-line)
        border-radius: 999px
        white-space: nowrap
        max-width: 22em
        .k
          color: var(--n2-fg-dim)
        .v
          overflow: hidden
          text-overflow: ellipsis
        .x
          display: inline-flex
          align-items: center
          justify-content: center
          width: 15px
          height: 15px
          font-size: 9px
          color: var(--n2-fg-dim)
          background: var(--n2-soft-hi)
          border-radius: 50%
          cursor: pointer
          &:hover
            color: var(--n2-bg)
            background: var(--n2-down)

      // ------------------------------------------------------------ 版面
      // .dash / .dash-cell 來自 dash.css, 這裡只加進場動畫
      .n2-board
        flex: 1 1 auto
        min-height: 0
      .dash > .dash-cell
        animation: n2-in .55s cubic-bezier(.22,.85,.3,1) both
        &:nth-child(1)
          animation-delay: .00s
        &:nth-child(2)
          animation-delay: .04s
        &:nth-child(3)
          animation-delay: .08s
        &:nth-child(4)
          animation-delay: .12s
        &:nth-child(5)
          animation-delay: .18s
        &:nth-child(6)
          animation-delay: .22s
        &:nth-child(7)
          animation-delay: .28s
        &:nth-child(8)
          animation-delay: .32s
        &:nth-child(9)
          animation-delay: .36s
      @keyframes n2-in
        from
          opacity: 0
          transform: translateY(10px)
        to
          opacity: 1
          transform: none

      // ------------------------------------------------- def 檢視 / 編輯
      .n2-drawer
        position: fixed
        top: 0
        left: 0
        width: 100%
        height: 100%
        z-index: 60
        visibility: hidden
        &.show
          visibility: visible
      .n2-mask
        position: absolute
        width: 100%
        height: 100%
        background: var(--n2-mask)
        opacity: 0
        transition: opacity .25s
      .n2-drawer.show .n2-mask
        opacity: 1
      .n2-win
        box-sizing: border-box
        position: absolute
        top: 0
        right: 0
        height: 100%
        // stylus 會在編譯期算掉 min(), 混單位的結果不是想要的 - 拆成兩行寫
        width: 900px
        max-width: 95vw
        display: flex
        flex-direction: column
        background: var(--n2-win)
        border-left: 1px solid var(--n2-line)
        box-shadow: var(--n2-win-shadow)
        transform: translateX(100%)
        transition: transform .32s cubic-bezier(.28,.84,.3,1)
      .n2-drawer.show .n2-win
        transform: none
      .n2-win-head
        flex: 0 0 auto
        display: flex
        align-items: flex-start
        gap: 10px
        padding: 18px 20px 14px
        border-bottom: 1px solid var(--n2-line)
      .n2-win-title
        font-size: 15px
        font-weight: 600
      .n2-win-body
        flex: 1 1 auto
        min-height: 0
        display: flex
      .n2-side
        box-sizing: border-box
        flex: 0 0 13em
        padding: 10px
        overflow-y: auto
        border-right: 1px solid var(--n2-line)
      .n2-item
        padding: 8px 11px
        border-radius: 8px
        cursor: pointer
        transition: .12s
        .label
          font-size: 12.5px
        .path
          margin-top: 2px
          font-size: 10.5px
          font-family: ui-monospace, "SF Mono", monospace
          color: var(--n2-fg-dim)
        &:hover
          background: var(--n2-soft)
        &.active
          background: var(--n2-soft-hi)
          .path
            color: var(--n2-fg)
      .n2-main
        flex: 1 1 auto
        min-width: 0
        display: flex
        flex-direction: column
        gap: 14px
        padding: 18px 20px
        overflow-y: auto
      .n2-desc
        font-size: 12.8px
        line-height: 1.75
        color: var(--n2-fg)
      .n2-field
        display: flex
        gap: 12px
        padding: 8px 0
        font-size: 12px
        border-top: 1px solid var(--n2-line)
        .key
          flex: 0 0 7em
          font-weight: 600
        .type
          flex: 0 0 14em
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 11.5px
          color: var(--n2-code)
          word-break: break-all
        .desc
          flex: 1 1 auto
          color: var(--n2-fg-dim)
      .n2-editor
        display: flex
        flex-direction: column
        gap: 8px
        textarea
          box-sizing: border-box
          width: 100%
          min-height: 18em
          padding: 12px
          font-family: ui-monospace, "SF Mono", monospace
          font-size: 11.5px
          line-height: 1.65
          color: var(--n2-fg)
          background: var(--n2-code-bg)
          border: 1px solid var(--n2-line)
          border-radius: 8px
          resize: vertical
          &:focus
            outline: none
            border-color: var(--n2-line-hi)
      .n2-foot
        display: flex
        align-items: center
        gap: 10px
      .n2-hint, .n2-msg
        font-size: 11.5px
        color: var(--n2-fg-dim)
  body
    .n2-page
      .n2-bar
        div
          .n2-eyebrow Independent Bookstores · 2024 · Synthetic
          .n2-h1 獨立書店銷售概況
          .n2-h2 @plotdb/dash · design-1「分析台」— 密集、滿版不捲動, 可切 light · dark
        .n2-spacer
        .n2-tools
          div(ld="chips",style="display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end")
          .n2-btn(ld="mode")
          a.n2-btn(href="/initiative/2nd/") 其他設計 ↗
          .n2-btn(ld="clear") 清除篩選
          .n2-btn.primary(ld="open-def") 儀表板定義
      .n2-board(ld="board")

    .n2-drawer(ld="defv")
      .n2-mask(ld="close-def")
      .n2-win
        .n2-win-head
          div
            .n2-win-title 儀表板定義 ( def )
            .n2-h2 一份 def 就是一個儀表板. 左側是要定義的東西, 右側可以直接改, 套用後立刻重建.
          .n2-spacer
          .n2-btn(ld="close-def") 關閉
        .n2-win-body
          .n2-side: .n2-item(ld-each="group")
            .label(ld="label")
            .path(ld="path")
          .n2-main
            .n2-desc(ld="desc")
            div
              .n2-field(ld-each="field")
                .key(ld="key")
                .type(ld="type")
                .desc(ld="fdesc")
            .n2-editor
              .n2-hint(ld="hint")
              textarea(ld="editor",spellcheck="false")
              .n2-foot
                .n2-btn.primary(ld="apply") 套用並重建
                .n2-btn(ld="reset") 還原
                .n2-msg(ld="msg")
    +script([
      {name: "proxise"},
      {name: "@loadingio/debounce.js"},
      {name: "@loadingio/ldquery"},
      {name: "@plotdb/semver"},
      {name: "@plotdb/csscope"},
      {name: "@plotdb/rescope"},
      {name: "@plotdb/block"},
      {name: "ldview"},
      {name: "papaparse", path: "papaparse.min.js"},
      {url: "/js/dash.js"}
    ])
    script(type="module"): include:lsc ../mode.ls
    script(type="module"): include:lsc index.ls
