doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport",content="width=device-width,initial-scale=1")
    title 主題 / @plotdb/dash
    +css([{url: "/css/dash.css"}])
    style(type="text/css"): :stylus
      // 這一頁自己的外殼只用兩個顏色, 其餘全部交給主題:
      // board.root 上的 custom property 會繼承下來, 所以連工具列都跟著換
      html, body
        margin: 0
        height: 100%
        font-family: -apple-system, "PingFang TC", "Noto Sans TC", sans-serif
      body
        display: flex
        flex-direction: column
        background: var(--dash-bg, #f7f8f9)
        color: var(--dash-fg, #333435)
      .bar
        display: flex
        align-items: center
        gap: .5em
        flex-wrap: wrap
        padding: .5em .8em
        border-bottom: 1px solid var(--dash-border, #e7e8e9)
      .ttl
        font-weight: 700
        margin-right: .4em
      .sub
        font-size: .8em
        opacity: .65
      .btn
        font: inherit
        font-size: .82em
        padding: .25em .7em
        cursor: pointer
        color: inherit
        background: transparent
        border: 1px solid var(--dash-border, #e7e8e9)
        border-radius: var(--dash-radius, .3em)
        &:hover
          border-color: var(--dash-accent, #0b7fab)
      .main
        flex: 1
        display: flex
        min-height: 0
      .board
        flex: 1
        min-width: 0
      .side
        width: 15em
        overflow: auto
        padding: .7em
        border-left: 1px solid var(--dash-border, #e7e8e9)
        font-size: .8em
      // 主題的自述: 想長成什麼樣 ( desc ), 以及配什麼版面 ( fit ).
      // fit 刻意跟 token 清單分開, 因為它不是可以改的東西, 是一句話
      .tk-about
        margin-bottom: .8em
        line-height: 1.5
        opacity: .7
      .tk-fit
        margin-bottom: 1.1em
        padding: .55em .7em
        line-height: 1.5
        border-left: 2px solid var(--dash-accent, #888)
        background: var(--dash-face, rgba(128,128,128,.08))
      .tk-fit-key
        margin-bottom: .2em
        font-weight: 600
      .tk-fit-txt
        opacity: .75
      .tk
        margin-bottom: .7em
      .tk-key
        display: block
        margin-bottom: .2em
      .tk-desc
        margin-top: .2em
        font-size: .9em
        opacity: .55
        line-height: 1.4
      .tk-colors
        display: flex
        flex-wrap: wrap
        gap: .2em
      .tk-color
        width: 1.8em
        height: 1.5em
        padding: 0
        border: 1px solid var(--dash-border, #e7e8e9)
        background: transparent
        cursor: pointer
      .tk-text
        width: 100%
        font: inherit
        color: inherit
        padding: .2em .4em
        background: transparent
        border: 1px solid var(--dash-border, #e7e8e9)
      pre
        margin: .6em 0 0
        font-size: .9em
        white-space: pre-wrap
        word-break: break-all
  body
    .bar
      .ttl 主題
      .sub 同一份 def, 換一個長相 ( def 裡沒有任何一個顏色 )
      .btn(ld="t-vanilla") 素版
      .btn(ld="t-desk") 分析台
      .btn(ld="t-report") 報告
      .btn(ld="t-wall") 牆面
      .btn(ld="t-terminal") 主控台
      .btn(ld="t-pocket") 口袋
      .btn(ld="t-rail") 側欄
      .btn(ld="m-light") 淺色
      .btn(ld="m-dark") 深色
      .btn(ld="m-auto") 跟系統
      .btn(ld="dump") 印出 def.theme
      .sub(ld="msg")
    .main
      .board(ld="board")
      .side
        div(ld="tokens")
        pre(ld="out")
    +script([
      {name: "proxise"},
      {name: "@loadingio/debounce.js"},
      {name: "@loadingio/ldquery"},
      {name: "@plotdb/semver"},
      {name: "@plotdb/csscope"},
      {name: "@plotdb/rescope"},
      {name: "@plotdb/block"},
      {name: "ldview"},
      {name: "papaparse", path: "papaparse.min.js"},
      {url: "/js/dash.js"}
    ])
    script(type="module"): include:lsc index.ls
