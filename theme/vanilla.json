{
  "name": "vanilla",
  "title": {
    "zh-TW": "素版",
    "en": "Plain"
  },
  "desc": {
    "zh-TW": "最素的那一份。顏色全部走 dash.css 的 --dash-* ，載了 index.css 就會長對。",
    "en": "The plainest one. Every colour comes from dash.css's --dash-* , so loading index.css is enough."
  },
  "blocks": {
    "panel": {
      "name": "@plotdb/dash",
      "path": "block/panel/index.html"
    },
    "filterbar": {
      "name": "@plotdb/dash",
      "path": "block/filterbar/index.html"
    }
  },
  "_layout": "12 欄: 2 / 3 / 4 / 6 都整除得開, 一份 def 換主題時格子不必重排。這只是建議值, def.theme.layout 給 true 才套, 而且只補 def.layout 沒寫的鍵。",
  "layout": {
    "col": [
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr",
      "1fr"
    ],
    "row": [
      "2.6em",
      "6.5em",
      "1fr",
      "1fr"
    ],
    "gap": ".8em"
  },
  "tokens": {
    "common": {
      "radius": ".3em",
      "gap": ".8em",
      "cat": [
        "#0b7fab",
        "#6ab7d4",
        "#f2a154",
        "#b6c454",
        "#9b8bbd",
        "#dd6e6e"
      ],
      "cat-ramp": [
        "#0b7fab",
        "#9b8bbd"
      ],
      "chn": [
        "#f2a154",
        "#b6c454",
        "#6ab7d4"
      ]
    },
    "light": {
      "bg": "#f7f8f9",
      "face": "#fff",
      "card": "#fff",
      "soft": "#fbfcfd",
      "border": "#e7e8e9",
      "fg": "#333435",
      "fg-dim": "#8b8d8f",
      "accent": "#0b7fab",
      "on-accent": "#fff",
      "ink": "#55585c",
      "line": "#d8dadd",
      "geo": [
        "#d0e5ee",
        "#9fccdd",
        "#6eb2cc",
        "#3c98bc",
        "#0b7fab"
      ],
      "geo-one": [
        "#0b7fab"
      ],
      "empty": "#e8e8e8",
      "outline": "#a5a7ae"
    },
    "dark": {
      "bg": "#15171a",
      "face": "#1d2024",
      "card": "#1d2024",
      "soft": "#262a30",
      "border": "#2e3238",
      "fg": "#d8dbdf",
      "fg-dim": "#8b9099",
      "accent": "#4db6dd",
      "on-accent": "#15171a",
      "ink": "#9aa0a8",
      "line": "#343a41",
      "geo": [
        "#2c353d",
        "#345565",
        "#3c768d",
        "#4596b5",
        "#4db6dd"
      ],
      "geo-one": [
        "#4db6dd"
      ],
      "empty": "#2a2a2d",
      "outline": "#565c64"
    }
  },
  "vars": {
    "--dash-bg": "$bg",
    "--dash-panel-bg": "$card",
    "--dash-border": "$border",
    "--dash-fg": "$fg",
    "--dash-fg-dim": "$fg-dim",
    "--dash-accent": "$accent",
    "--dash-on-accent": "$on-accent",
    "--dash-face": "$soft",
    "--dash-radius": "$radius",
    "--dash-gap": "$gap"
  },
  "root": {
    "background": "$bg",
    "color": "$fg"
  },
  "cfg": {
    "color": "$ink",
    "xaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$ink"
      },
      "tick": {
        "color": "$line"
      },
      "baseline": {
        "color": "$line"
      }
    },
    "yaxis": {
      "caption": {
        "show": false
      },
      "label": {
        "format": ".2~s",
        "color": "$ink"
      },
      "tick": {
        "color": "$line"
      },
      "baseline": {
        "color": "$line"
      }
    },
    "common": {
      "subset": {
        "background": "$face"
      }
    }
  },
  "hue": {
    "cat": {
      "palette": {
        "colors": "$cat"
      }
    },
    "cat-ramp": {
      "palette": {
        "colors": "$cat-ramp"
      }
    },
    "chn": {
      "palette": {
        "colors": "$chn"
      }
    },
    "geo": {
      "palette": {
        "colors": "$geo-one"
      }
    },
    "geo-ramp": {
      "palette": {
        "colors": "$geo"
      }
    }
  },
  "chart": {
    "@makechart/taiwan-map": {
      "border": {
        "color": "$outline",
        "width": 1
      }
    },
    "@makechart/twmapadv": {
      "border": {
        "color": "$outline",
        "width": 0.6
      },
      "heat": {
        "sequential": {
          "colors": "$geo"
        },
        "empty": "$empty"
      },
      "label": {
        "color": "$ink",
        "halo": "$face"
      },
      "village": {
        "mode": "none"
      }
    }
  },
  "role": {},
  "schema": [
    {
      "key": "accent",
      "type": "color",
      "label": {
        "zh-TW": "主色",
        "en": "Accent"
      },
      "desc": {
        "zh-TW": "按鈕、選取狀態、強調用",
        "en": "Buttons, selected state, emphasis"
      }
    },
    {
      "key": "cat",
      "type": "colors",
      "label": {
        "zh-TW": "資料色票",
        "en": "Category palette"
      },
      "desc": {
        "zh-TW": "並列的類別用這一組。中間調的顏色在兩個底色上通常都活得下去",
        "en": "For side-by-side categories. Mid-tone colours usually survive both backgrounds"
      }
    },
    {
      "key": "geo",
      "type": "colors",
      "label": {
        "zh-TW": "地圖色階",
        "en": "Map ramp"
      },
      "desc": {
        "zh-TW": "由淺到深。低端貼著底色，底色換了它就得換",
        "en": "Light to dark. The low end sits against the background, so it has to change when the background does"
      }
    },
    {
      "key": "empty",
      "type": "color",
      "label": {
        "zh-TW": "沒有資料",
        "en": "No data"
      },
      "desc": {
        "zh-TW": "刻意跟資料色分開：沒有資料跟「數值最低」是兩件事",
        "en": "Deliberately separate from the data colours: no data and lowest value are two different things"
      }
    },
    {
      "key": "bg",
      "type": "color",
      "label": {
        "zh-TW": "頁面底色",
        "en": "Page background"
      }
    },
    {
      "key": "card",
      "type": "color",
      "label": {
        "zh-TW": "卡片底色",
        "en": "Card background"
      }
    },
    {
      "key": "border",
      "type": "color",
      "label": {
        "zh-TW": "卡片邊線",
        "en": "Card border"
      }
    },
    {
      "key": "fg",
      "type": "color",
      "label": {
        "zh-TW": "文字",
        "en": "Text"
      }
    },
    {
      "key": "fg-dim",
      "type": "color",
      "label": {
        "zh-TW": "次要文字",
        "en": "Secondary text"
      }
    },
    {
      "key": "radius",
      "type": "length",
      "label": {
        "zh-TW": "圓角",
        "en": "Corner radius"
      }
    },
    {
      "key": "gap",
      "type": "length",
      "label": {
        "zh-TW": "格子間距",
        "en": "Cell gap"
      }
    }
  ]
}
